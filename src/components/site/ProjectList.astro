---
// Compact list of projects used on the home page (utilities and apps).
interface Props {
  items: { href: string; name: string; version?: string; swatch: string; text: string }[];
}
const { items } = Astro.props;
---
<ul class="flex flex-col border-t border-ink">
  {items.map((a) => (
    <li class="border-b border-line">
      <a href={a.href} class="group grid min-h-14 grid-cols-[14px_minmax(0,1fr)_auto] items-center gap-x-4 gap-y-1 py-3 sm:grid-cols-[14px_160px_minmax(0,1fr)_auto]">
        <span aria-hidden="true" class="h-3 w-3" style={`background:${a.swatch}`}></span>
        <span class="font-display text-lg font-medium underline decoration-transparent decoration-2 underline-offset-4 group-hover:decoration-fageda">{a.name}</span>
        <span class="col-start-2 text-[15px] text-graphite sm:col-start-auto">{a.text}</span>
        <span class="row-start-1 font-mono text-xs text-graphite sm:row-start-auto" style="grid-column:-2/-1">{a.version}</span>
      </a>
    </li>
  ))}
</ul>
