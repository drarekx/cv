---
interface Props {
  title?: string;
  /** Voice of the form copy: `tu` (home) or `vos` (/serveis, addressed to companies). */
  voice?: 'tu' | 'vos';
}
const { title = 'Parlem?', voice = 'tu' } = Astro.props;
const copy =
  voice === 'vos'
    ? { heading: 'Escriviu-me', need: 'Què necessiteu?', note: 'Només faig servir aquestes dades per respondre-us.' }
    : { heading: 'Escriu-me', need: 'Què necessites?', note: 'Només faig servir aquestes dades per respondre\'t.' };

const field = 'w-full border border-fog bg-ink px-4 py-3 text-base text-paper placeholder:text-fog focus:border-fageda focus:outline-none focus-visible:ring-2 focus-visible:ring-fageda';
const label = 'flex flex-col gap-2 text-[15px] text-fog';
---
<footer id="contacte" class="bg-ink text-paper">
  <div class="mx-auto flex max-w-[1200px] flex-col gap-12 px-6 pt-24 pb-16">
    <div class="flex flex-wrap gap-x-16 gap-y-12">
      <div class="flex min-w-0 flex-[1_1_360px] flex-col gap-8">
        <div class="flex flex-col gap-4">
          <h2 class="font-display text-[clamp(40px,5.6vw,76px)] leading-[0.95] font-medium tracking-[-0.035em]">{title}</h2>
          <div class="max-w-[520px] text-lg text-fog [&_a]:text-paper [&_a]:underline [&_a]:decoration-fageda [&_a]:underline-offset-4"><slot /></div>
        </div>
        <ul class="flex flex-col border-t border-line-dark text-[15px]">
          <li class="border-b border-line-dark"><a href="mailto:fortea.gerard@mail.com" class="flex min-h-12 items-center justify-between gap-4 hover:text-fageda"><span>fortea.gerard@mail.com</span><span class="text-fog">Correu</span></a></li>
          <li class="border-b border-line-dark"><a href="tel:+34616271011" class="flex min-h-12 items-center justify-between gap-4 hover:text-fageda"><span>+34 616 27 10 11</span><span class="text-fog">Telèfon</span></a></li>
          <li class="border-b border-line-dark"><a href="https://github.com/drarekx" target="_blank" rel="noopener noreferrer" class="flex min-h-12 items-center justify-between gap-4 hover:text-fageda"><span>github.com/drarekx</span><span class="text-fog">GitHub</span></a></li>
          <li class="border-b border-line-dark"><a href="https://www.linkedin.com/in/gerard-fortea-a3863741/" target="_blank" rel="noopener noreferrer" class="flex min-h-12 items-center justify-between gap-4 hover:text-fageda"><span>linkedin.com/in/gerard-fortea</span><span class="text-fog">LinkedIn</span></a></li>
        </ul>
      </div>

      <form
        data-contact-form
        action="/api/contacte"
        method="post"
        class="flex min-w-0 flex-[1_1_440px] flex-col gap-5"
        aria-labelledby="contacte-form-titol"
      >
        <h3 id="contacte-form-titol" class="font-display text-2xl font-medium tracking-[-0.02em]">{copy.heading}</h3>
        <div class="grid gap-5 sm:grid-cols-2">
          <label class={label}>
            Nom
            <input class={field} type="text" name="nom" required minlength="2" maxlength="100" autocomplete="name" />
          </label>
          <label class={label}>
            Correu
            <input class={field} type="email" name="email" required maxlength="200" autocomplete="email" />
          </label>
        </div>
        <label class={label}>
          <span>Telèfon (opcional)</span>
          <input class={field} type="tel" name="telefon" maxlength="30" autocomplete="tel" />
        </label>
        <label class={label}>
          {copy.need}
          <textarea class={`${field} min-h-36 resize-y`} name="missatge" required minlength="10" maxlength="5000" rows="5"></textarea>
        </label>

        <!-- Anti-spam: people never see or fill `web`; `t` records when the form was shown. -->
        <div aria-hidden="true" class="absolute -left-[9999px] h-px w-px overflow-hidden">
          <label>No omplis aquest camp <input type="text" name="web" tabindex="-1" autocomplete="off" /></label>
        </div>
        <input type="hidden" name="t" value="" />

        <div class="flex flex-wrap items-center gap-x-6 gap-y-3">
          <button
            type="submit"
            class="flex min-h-[52px] cursor-pointer items-center gap-3 bg-fageda px-7 text-[15px] font-medium text-ink hover:bg-paper disabled:cursor-wait disabled:opacity-70"
          >Envia el missatge</button>
          <p class="text-sm text-fog">{copy.note} <a href="/privacitat" class="text-paper underline underline-offset-2">Privacitat</a></p>
        </div>
        <p data-contact-status id="contacte-error" role="alert" tabindex="-1" class="min-h-6 text-base font-medium text-lava outline-none empty:hidden"></p>
      </form>

      <!-- Shown in place of the form once the message is sent. Same footprint, so the page doesn't jump. -->
      <div
        data-contact-done
        hidden
        class="flex min-w-0 flex-[1_1_440px] flex-col items-start justify-center gap-6 border border-fageda p-8 sm:p-10"
      >
        <span aria-hidden="true" class="animate-pop flex h-14 w-14 items-center justify-center bg-fageda text-ink">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="square" stroke-linejoin="miter" class="h-7 w-7">
            <path d="M5 12.5 10 17.5 19 7"></path>
          </svg>
        </span>
        <div class="flex flex-col gap-2">
          <h3 data-contact-done-title tabindex="-1" class="font-display text-[clamp(28px,3.4vw,40px)] leading-[1.05] font-medium tracking-[-0.02em] outline-none">
            He rebut el teu missatge!
          </h3>
          <p class="max-w-[440px] text-lg text-fog">En breu em poso en contacte amb tu.</p>
        </div>
        <button
          type="button"
          data-contact-again
          class="flex min-h-11 cursor-pointer items-center border border-paper px-5 text-[15px] hover:bg-paper hover:text-ink"
        >Envia'n un altre</button>
      </div>
    </div>
  </div>
  <div class="border-t border-line-dark">
    <div class="mx-auto flex max-w-[1200px] flex-wrap items-center justify-between gap-x-6 gap-y-1 px-6 py-4 text-sm text-fog">
      <p>© {new Date().getFullYear()} Gerard Fortea Castellsague</p>
      <nav aria-label="Legal" class="flex gap-x-6">
        <a href="/avis-legal" class="flex min-h-11 items-center hover:text-paper">Avís legal</a>
        <a href="/privacitat" class="flex min-h-11 items-center hover:text-paper">Privacitat</a>
      </nav>
    </div>
  </div>
</footer>

<script>
  const form = document.querySelector<HTMLFormElement>('[data-contact-form]');
  const done = document.querySelector<HTMLElement>('[data-contact-done]');
  if (form && done) {
    const status = form.querySelector<HTMLElement>('[data-contact-status]')!;
    const button = form.querySelector<HTMLButtonElement>('button[type="submit"]')!;
    const started = form.querySelector<HTMLInputElement>('input[name="t"]')!;
    const doneTitle = done.querySelector<HTMLElement>('[data-contact-done-title]')!;
    started.value = String(Date.now());

    const showDone = (name: string) => {
      const first = name.trim().split(/\s+/)[0];
      doneTitle.textContent = first ? `Gràcies, ${first}! He rebut el teu missatge.` : 'He rebut el teu missatge!';
      done.style.minHeight = `${form.offsetHeight}px`;
      form.hidden = true;
      done.hidden = false;
      doneTitle.focus({ preventScroll: true });
    };

    done.querySelector('[data-contact-again]')!.addEventListener('click', () => {
      done.hidden = true;
      form.hidden = false;
      started.value = String(Date.now());
      form.querySelector<HTMLInputElement>('input[name="nom"]')!.focus();
    });

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      button.disabled = true;
      button.textContent = 'Enviant…';
      status.textContent = '';
      try {
        const res = await fetch(form.action, {
          method: 'POST',
          body: new FormData(form),
          headers: { Accept: 'application/json' },
        });
        const data = (await res.json().catch(() => null)) as { ok?: boolean; message?: string } | null;
        if (res.ok && data?.ok) {
          const name = String(new FormData(form).get('nom') ?? '');
          form.reset();
          showDone(name);
        } else {
          status.textContent = data?.message ?? 'No s\'ha pogut enviar. Escriu-me a fortea.gerard@mail.com.';
          status.focus();
        }
      } catch {
        status.textContent = 'No hi ha connexió. Torna-ho a provar o escriu-me a fortea.gerard@mail.com.';
        status.focus();
      } finally {
        button.disabled = false;
        button.textContent = 'Envia el missatge';
      }
    });
  }
</script>
