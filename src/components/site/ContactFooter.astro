---
import { localePath, type Lang } from '../../i18n';
import { useUi } from '../../i18n/ui';

interface Props {
  lang: Lang;
  title?: string;
  /** Voice of the form copy: `tu` (home) or `vos` (/serveis, addressed to companies). Spanish: tú / vosotros. */
  voice?: 'tu' | 'vos';
}
const t = useUi(Astro.props.lang).contact;
const legal = useUi(Astro.props.lang).legal;
const { lang, title = t.title, voice = 'tu' } = Astro.props;
const copy = t.voice[voice];
/** Texts the client script needs (it runs in the browser and can't import the dictionaries). */
const scriptCopy = {
  doneTitle: copy.doneTitle,
  doneTitleNamed: copy.doneTitleNamed,
  sendFailed: copy.sendFailed,
  offline: copy.offline,
  send: t.send,
  sending: t.sending,
};

// Errors only show under `:user-invalid` (after the visitor touches the field or tries to send), never `:invalid`.
// Lava on ink: 5:1, the same colour as the send error below the button.
const field = 'w-full border border-fog bg-ink px-4 py-3 text-base text-paper placeholder:text-fog focus:border-fageda focus:outline-none focus-visible:ring-2 focus-visible:ring-fageda user-invalid:border-lava focus:user-invalid:border-lava';
const label = 'flex flex-col gap-2 text-[15px] text-fog';
/** Field + its error. The error sits outside the <label> so it doesn't end up in the field's accessible name. */
const fieldWrap = 'group/field flex flex-col gap-2';
/** Hidden until the field is :user-invalid. The script links it with aria-describedby only while it's visible. */
const fieldError = 'hidden text-[15px] font-medium text-lava group-has-[:user-invalid]/field:block';
---
<footer id="contacte" class="bg-ink text-paper">
  <div class="mx-auto flex max-w-[1200px] flex-col gap-12 px-6 pt-24 pb-16">
    <div class="flex flex-wrap gap-x-16 gap-y-12">
      <div class="flex min-w-0 flex-[1_1_360px] flex-col gap-8">
        <div class="flex flex-col gap-4">
          <h2 class="font-display text-[clamp(40px,5.6vw,76px)] leading-[0.95] font-medium tracking-[-0.035em]">{title}</h2>
          <div class="max-w-[520px] text-lg text-fog [&_a]:text-paper [&_a]:underline [&_a]:decoration-fageda [&_a]:underline-offset-4"><slot /></div>
        </div>
        <ul class="flex flex-col border-t border-line-dark text-[15px]">
          <li class="border-b border-line-dark"><a href="mailto:fortea.gerard@mail.com" class="flex min-h-12 items-center justify-between gap-4 hover:text-fageda"><span>fortea.gerard@mail.com</span><span class="text-fog">{t.email}</span></a></li>
          <li class="border-b border-line-dark"><a href="tel:+34616271011" class="flex min-h-12 items-center justify-between gap-4 hover:text-fageda"><span>+34 616 27 10 11</span><span class="text-fog">{t.phone}</span></a></li>
          <li class="border-b border-line-dark"><a href="https://github.com/drarekx" target="_blank" rel="noopener noreferrer" class="flex min-h-12 items-center justify-between gap-4 hover:text-fageda"><span>github.com/drarekx</span><span class="text-fog">GitHub</span></a></li>
          <li class="border-b border-line-dark"><a href="https://www.linkedin.com/in/gerard-fortea-a3863741/" target="_blank" rel="noopener noreferrer" class="flex min-h-12 items-center justify-between gap-4 hover:text-fageda"><span>linkedin.com/in/gerard-fortea</span><span class="text-fog">LinkedIn</span></a></li>
        </ul>
      </div>

      <form
        data-contact-form
        action="/api/contacte"
        method="post"
        class="flex min-w-0 flex-[1_1_440px] flex-col gap-5"
        aria-labelledby="contacte-form-titol"
      >
        <h3 id="contacte-form-titol" class="font-display text-2xl font-medium tracking-[-0.02em]">{copy.heading}</h3>
        <div class="grid gap-5 sm:grid-cols-2">
          <div class={fieldWrap}>
            <label class={label}>
              {t.nameField}
              <input class={field} type="text" name="nom" required minlength="2" maxlength="100" autocomplete="name" data-error="contacte-nom-error" />
            </label>
            <p id="contacte-nom-error" class={fieldError}>{copy.nameError}</p>
          </div>
          <div class={fieldWrap}>
            <label class={label}>
              {t.emailField}
              <input class={field} type="email" name="email" required maxlength="200" autocomplete="email" data-error="contacte-email-error" />
            </label>
            <p id="contacte-email-error" class={fieldError}>{copy.emailError}</p>
          </div>
        </div>
        <label class={label}>
          <span>{t.phoneField}</span>
          <input class={field} type="tel" name="telefon" maxlength="30" autocomplete="tel" />
        </label>
        <div class={fieldWrap}>
          <label class={label}>
            {copy.need}
            <textarea class={`${field} min-h-36 resize-y`} name="missatge" required minlength="10" maxlength="5000" rows="5" data-error="contacte-missatge-error"></textarea>
          </label>
          <p id="contacte-missatge-error" class={fieldError}>{copy.needError}</p>
        </div>

        <!-- Anti-spam: people never see or fill `web`; `t` records when the form was shown. -->
        <div aria-hidden="true" class="absolute -left-[9999px] h-px w-px overflow-hidden">
          <label>{t.honeypot} <input type="text" name="web" tabindex="-1" autocomplete="off" /></label>
        </div>
        <input type="hidden" name="t" value="" />
        <!-- Language of the visitor: the server answers in it (no-JS page, errors). -->
        <input type="hidden" name="lang" value={lang} />

        <div class="flex flex-wrap items-center gap-x-6 gap-y-3">
          <button
            type="submit"
            class="flex min-h-[52px] cursor-pointer items-center gap-3 bg-fageda px-7 text-[15px] font-medium text-ink hover:bg-paper disabled:cursor-wait disabled:opacity-70"
          >{t.send}</button>
          <p class="text-sm text-fog">{copy.note} <a href={localePath(lang, '/privacitat')} class="text-paper underline underline-offset-2">{t.privacy}</a></p>
        </div>
        <p data-contact-status id="contacte-error" role="alert" tabindex="-1" class="min-h-6 text-base font-medium text-lava outline-none empty:hidden"></p>
      </form>

      <!-- Shown in place of the form once the message is sent. Same footprint, so the page doesn't jump. -->
      <div
        data-contact-done
        hidden
        class="flex min-w-0 flex-[1_1_440px] flex-col items-start justify-center gap-6 border border-fageda p-8 sm:p-10"
      >
        <span aria-hidden="true" class="motion-safe:animate-pop flex h-14 w-14 items-center justify-center bg-fageda text-ink">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="square" stroke-linejoin="miter" class="h-7 w-7">
            <path d="M5 12.5 10 17.5 19 7"></path>
          </svg>
        </span>
        <div class="flex flex-col gap-2">
          <h3 data-contact-done-title tabindex="-1" class="font-display text-[clamp(28px,3.4vw,40px)] leading-[1.05] font-medium tracking-[-0.02em] outline-none">
            {copy.doneTitle}
          </h3>
          <p class="max-w-[440px] text-lg text-fog">{copy.doneText}</p>
        </div>
        <button
          type="button"
          data-contact-again
          class="flex min-h-11 cursor-pointer items-center border border-paper px-5 text-[15px] hover:bg-paper hover:text-ink"
        >{t.sendAnother}</button>
      </div>
    </div>
  </div>
  <div class="border-t border-line-dark">
    <div class="mx-auto flex max-w-[1200px] flex-wrap items-center justify-between gap-x-6 gap-y-1 px-6 py-4 text-sm text-fog">
      <p>© {new Date().getFullYear()} Gerard Fortea Castellsague</p>
      <nav aria-label={legal.navLabel} class="flex gap-x-6">
        <a href={localePath(lang, '/avis-legal')} class="flex min-h-11 items-center hover:text-paper">{legal.notice}</a>
        <a href={localePath(lang, '/privacitat')} class="flex min-h-11 items-center hover:text-paper">{legal.privacy}</a>
      </nav>
    </div>
  </div>
  <script type="application/json" data-contact-copy set:html={JSON.stringify(scriptCopy)} />
</footer>

<script>
  const form = document.querySelector<HTMLFormElement>('[data-contact-form]');
  const done = document.querySelector<HTMLElement>('[data-contact-done]');
  const copyEl = document.querySelector('[data-contact-copy]');
  if (form && done && copyEl) {
    // Translated texts, written by the component as JSON (see `scriptCopy`).
    const copy = JSON.parse(copyEl.textContent ?? '{}') as Record<
      'doneTitle' | 'doneTitleNamed' | 'sendFailed' | 'offline' | 'send' | 'sending',
      string
    >;
    const status = form.querySelector<HTMLElement>('[data-contact-status]')!;
    const button = form.querySelector<HTMLButtonElement>('button[type="submit"]')!;
    const started = form.querySelector<HTMLInputElement>('input[name="t"]')!;
    const doneTitle = done.querySelector<HTMLElement>('[data-contact-done-title]')!;
    started.value = String(Date.now());

    // Field errors: the message is in the markup and CSS shows it under :user-invalid. This keeps
    // aria-invalid and aria-describedby in step with it and announces the error once, on leaving the field.
    type Field = HTMLInputElement | HTMLTextAreaElement;
    const fields = Array.from(form.querySelectorAll<Field>('[data-error]'));
    /** Fields whose aria-invalid="true" was set by this script (any other one is left alone). */
    const flagged = new WeakSet<Element>();
    /** Fields whose current error has already been spoken. */
    const announced = new WeakSet<Element>();
    const announcer = document.createElement('div');
    announcer.className = 'sr-only';
    announcer.setAttribute('aria-live', 'polite');
    document.body.append(announcer);
    let announcing: Element | null = null;
    let announceTimer: number | undefined;

    const describedBy = (el: Element) => (el.getAttribute('aria-describedby') ?? '').split(/\s+/).filter(Boolean);

    /** What a screen reader says as the field's label: no control, no error text, no aria-hidden nodes. */
    const labelText = (el: Field, error: Element | null) => {
      const lbl = el.labels?.[0];
      if (!lbl) return el.getAttribute('aria-label') ?? '';
      const clone = lbl.cloneNode(true) as HTMLElement;
      clone.querySelectorAll('input, textarea, select, [aria-hidden="true"]').forEach((n) => n.remove());
      if (error?.id) clone.querySelector(`#${CSS.escape(error.id)}`)?.remove();
      return (clone.textContent ?? '').replace(/\s+/g, ' ').trim();
    };

    const announce = (el: Field, error: Element) => {
      announced.add(el);
      announcing = el;
      window.clearTimeout(announceTimer);
      announcer.textContent = '';
      const text = `${labelText(el, error)}: ${(error.textContent ?? '').trim()}`;
      announceTimer = window.setTimeout(() => {
        if (announcing === el) announcer.textContent = text;
      }, 500);
    };

    const syncAria = (el: Field, speak = false) => {
      const errorId = el.dataset.error;
      if (!errorId) return;
      const error = document.getElementById(errorId);
      const ids = describedBy(el).filter((id) => id !== errorId);
      if (el.matches(':user-invalid')) {
        if (el.getAttribute('aria-invalid') !== 'true') flagged.add(el);
        el.setAttribute('aria-invalid', 'true');
        el.setAttribute('aria-describedby', [...ids, errorId].join(' '));
        if (speak && error && !announced.has(el)) announce(el, error);
      } else {
        if (flagged.has(el) || el.getAttribute('aria-invalid') !== 'true') {
          el.setAttribute('aria-invalid', 'false');
          flagged.delete(el);
        }
        if (ids.length) el.setAttribute('aria-describedby', ids.join(' '));
        else el.removeAttribute('aria-describedby');
        announced.delete(el);
        if (announcing === el) {
          window.clearTimeout(announceTimer);
          announcer.textContent = '';
          announcing = null;
        }
      }
    };
    const syncAll = () => fields.forEach((el) => syncAria(el));

    // Empty required fields are exposed as invalid from load in some browsers: start them as valid.
    fields.forEach((el) => {
      if (!el.hasAttribute('aria-invalid')) el.setAttribute('aria-invalid', 'false');
    });

    const asField = (target: EventTarget | null) =>
      target instanceof Element && fields.includes(target as Field) ? (target as Field) : null;
    form.addEventListener('blur', (e) => {
      const el = asField(e.target);
      if (el) syncAria(el, true);
    }, true);
    form.addEventListener('input', (e) => {
      const el = asField(e.target);
      if (el?.hasAttribute('aria-invalid')) syncAria(el);
    }, true);
    form.addEventListener('change', (e) => {
      const el = asField(e.target);
      if (el) syncAria(el, true);
    }, true);
    form.addEventListener('invalid', (e) => {
      const el = asField(e.target);
      if (!el) return;
      // The browser moves focus to the first invalid field, which reads its error: don't repeat it.
      announced.add(el);
      syncAria(el);
      // :user-invalid may only start matching once the submit attempt is over.
      window.setTimeout(() => syncAria(el));
    }, true);
    form.addEventListener('reset', () => window.setTimeout(syncAll), true);

    const showDone = (name: string) => {
      const first = name.trim().split(/\s+/)[0];
      doneTitle.textContent = first ? copy.doneTitleNamed.replace('{name}', () => first) : copy.doneTitle;
      done.style.minHeight = `${form.offsetHeight}px`;
      form.hidden = true;
      done.hidden = false;
      doneTitle.focus({ preventScroll: true });
    };

    done.querySelector('[data-contact-again]')!.addEventListener('click', () => {
      done.hidden = true;
      form.hidden = false;
      started.value = String(Date.now());
      form.querySelector<HTMLInputElement>('input[name="nom"]')!.focus();
    });

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      button.disabled = true;
      button.setAttribute('aria-busy', 'true');
      button.textContent = copy.sending;
      status.textContent = '';
      try {
        const res = await fetch(form.action, {
          method: 'POST',
          body: new FormData(form),
          headers: { Accept: 'application/json' },
        });
        const data = (await res.json().catch(() => null)) as { ok?: boolean; message?: string } | null;
        if (res.ok && data?.ok) {
          const name = String(new FormData(form).get('nom') ?? '');
          form.reset();
          showDone(name);
        } else {
          status.textContent = data?.message ?? copy.sendFailed;
          status.focus();
        }
      } catch {
        status.textContent = copy.offline;
        status.focus();
      } finally {
        button.disabled = false;
        button.removeAttribute('aria-busy');
        button.textContent = copy.send;
      }
    });
  }
</script>
