---
interface Props {
  title?: string;
}
const { title = 'Parlem?' } = Astro.props;

const field = 'w-full rounded-xl border-2 border-ink bg-[#f4ffd6] px-4 py-3 text-base text-ink placeholder:text-ink/55 focus:bg-white focus:outline-none focus-visible:ring-4 focus-visible:ring-ink/25';
const label = 'flex flex-col gap-1.5 text-sm font-semibold';
---
<footer id="contacte" class="bg-acid text-ink">
  <div class="mx-auto flex max-w-[1200px] flex-wrap gap-x-16 gap-y-10 px-6 py-16">
    <div class="flex min-w-0 flex-[1_1_360px] flex-col gap-6">
      <div class="flex flex-col gap-2.5">
        <h2 class="font-display text-[clamp(36px,5vw,64px)] leading-none font-bold tracking-[-0.03em]">{title}</h2>
        <div class="max-w-[520px] text-lg"><slot /></div>
      </div>
      <div class="flex flex-col gap-0.5 font-mono text-sm font-bold">
        <a href="mailto:fortea.gerard@mail.com" class="flex min-h-11 items-center underline-offset-4 hover:underline">fortea.gerard@mail.com</a>
        <a href="tel:+34616271011" class="flex min-h-11 items-center underline-offset-4 hover:underline">+34 616 27 10 11</a>
        <a href="https://github.com/drarekx" target="_blank" rel="noopener noreferrer" class="flex min-h-11 items-center underline-offset-4 hover:underline">github.com/drarekx</a>
        <a href="https://www.linkedin.com/in/gerard-fortea-a3863741/" target="_blank" rel="noopener noreferrer" class="flex min-h-11 items-center underline-offset-4 hover:underline">linkedin · gerard-fortea</a>
      </div>
    </div>

    <form
      data-contact-form
      action="/api/contacte"
      method="post"
      class="flex min-w-0 flex-[1_1_440px] flex-col gap-4"
      aria-labelledby="contacte-form-titol"
    >
      <h3 id="contacte-form-titol" class="font-display text-2xl font-bold">Escriu-me</h3>
      <div class="grid gap-4 sm:grid-cols-2">
        <label class={label}>
          Nom
          <input class={field} type="text" name="nom" required minlength="2" maxlength="100" autocomplete="name" />
        </label>
        <label class={label}>
          Correu
          <input class={field} type="email" name="email" required maxlength="200" autocomplete="email" />
        </label>
      </div>
      <label class={label}>
        <span>Telèfon <span class="font-normal">(opcional)</span></span>
        <input class={field} type="tel" name="telefon" maxlength="30" autocomplete="tel" />
      </label>
      <label class={label}>
        Què necessites?
        <textarea class={`${field} min-h-36 resize-y`} name="missatge" required minlength="10" maxlength="5000" rows="5"></textarea>
      </label>

      <!-- Anti-spam: people never see or fill `web`; `t` records when the form was shown. -->
      <div aria-hidden="true" class="absolute -left-[9999px] h-px w-px overflow-hidden">
        <label>No omplis aquest camp <input type="text" name="web" tabindex="-1" autocomplete="off" /></label>
      </div>
      <input type="hidden" name="t" value="" />

      <div class="flex flex-wrap items-center gap-x-5 gap-y-3">
        <button
          type="submit"
          class="flex min-h-[52px] cursor-pointer items-center rounded-full bg-ink px-7 text-[15px] font-semibold text-acid hover:bg-[#2a2d35] disabled:cursor-wait disabled:opacity-70"
        >Envia el missatge</button>
        <p class="text-sm">Només faig servir aquestes dades per respondre't.</p>
      </div>
      <p data-contact-status role="status" aria-live="polite" class="min-h-6 text-base font-semibold empty:hidden"></p>
    </form>

    <!-- Shown in place of the form once the message is sent. Same footprint, so the page doesn't jump. -->
    <div
      data-contact-done
      hidden
      class="flex min-w-0 flex-[1_1_440px] flex-col items-start justify-center gap-5 rounded-3xl border-2 border-ink bg-[#f4ffd6] p-8 sm:p-10"
    >
      <span aria-hidden="true" class="animate-pop flex h-16 w-16 items-center justify-center rounded-full bg-ink text-acid">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" class="h-8 w-8">
          <path d="M5 12.5 10 17.5 19 7"></path>
        </svg>
      </span>
      <div class="flex flex-col gap-2">
        <h3 data-contact-done-title tabindex="-1" class="font-display text-[clamp(28px,3.4vw,40px)] leading-[1.05] font-bold tracking-[-0.02em] outline-none">
          He rebut el teu missatge!
        </h3>
        <p class="max-w-[440px] text-lg">En breu em poso en contacte amb tu.</p>
      </div>
      <button
        type="button"
        data-contact-again
        class="flex min-h-11 cursor-pointer items-center rounded-full border-2 border-ink px-5 text-sm font-semibold hover:bg-ink hover:text-acid"
      >Envia'n un altre</button>
    </div>
  </div>
</footer>

<script>
  const form = document.querySelector<HTMLFormElement>('[data-contact-form]');
  const done = document.querySelector<HTMLElement>('[data-contact-done]');
  if (form && done) {
    const status = form.querySelector<HTMLElement>('[data-contact-status]')!;
    const button = form.querySelector<HTMLButtonElement>('button[type="submit"]')!;
    const started = form.querySelector<HTMLInputElement>('input[name="t"]')!;
    const doneTitle = done.querySelector<HTMLElement>('[data-contact-done-title]')!;
    started.value = String(Date.now());

    const showDone = (name: string) => {
      const first = name.trim().split(/\s+/)[0];
      doneTitle.textContent = first ? `Gràcies, ${first}! He rebut el teu missatge.` : 'He rebut el teu missatge!';
      done.style.minHeight = `${form.offsetHeight}px`;
      form.hidden = true;
      done.hidden = false;
      doneTitle.focus({ preventScroll: true });
    };

    done.querySelector('[data-contact-again]')!.addEventListener('click', () => {
      done.hidden = true;
      form.hidden = false;
      started.value = String(Date.now());
      form.querySelector<HTMLInputElement>('input[name="nom"]')!.focus();
    });

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      button.disabled = true;
      button.textContent = 'Enviant…';
      status.textContent = '';
      try {
        const res = await fetch(form.action, {
          method: 'POST',
          body: new FormData(form),
          headers: { Accept: 'application/json' },
        });
        const data = (await res.json().catch(() => null)) as { ok?: boolean; message?: string } | null;
        if (res.ok && data?.ok) {
          const name = String(new FormData(form).get('nom') ?? '');
          form.reset();
          showDone(name);
        } else {
          status.textContent = data?.message ?? 'No s\'ha pogut enviar. Escriu-me a fortea.gerard@mail.com.';
        }
      } catch {
        status.textContent = 'No hi ha connexió. Torna-ho a provar o escriu-me a fortea.gerard@mail.com.';
      } finally {
        button.disabled = false;
        button.textContent = 'Envia el missatge';
      }
    });
  }
</script>
