---
/**
 * The brand symbol (variant C): a faceted volcanic ridge with a crater whose ridges become circuit traces
 * ending in hollow square pads. Same geometry as public/brand/simbol-*.svg. Uses currentColor.
 */
interface Props {
  class?: string;
  /** Stroke in symbol units (viewBox is 200 × 112). Thicker for small renders. */
  stroke?: number;
  label?: string;
}
const { class: className = '', stroke = 2.5, label } = Astro.props;
---
<svg
  viewBox="0 0 200 112"
  class={className}
  fill="none"
  stroke="currentColor"
  stroke-width={stroke}
  stroke-linecap="square"
  stroke-linejoin="miter"
  stroke-miterlimit="10"
  {...(label ? { role: 'img', 'aria-label': label } : { 'aria-hidden': 'true' })}
>
  <path d="M8 102 L 32 66 L 46 32 L 54 22 L 61 30 L 68 22 L 82 46 L 96 60 L 100 62 H 134 L 148 48 H 176"></path>
  <path d="M40 102 L 60 86 L 82 80 H 150 L 160 70 H 176"></path>
  <path d="M8 102 H 158 L 168 92 H 176"></path>
  <rect x="177" y="43" width="10" height="10"></rect>
  <rect x="177" y="65" width="10" height="10"></rect>
  <rect x="177" y="87" width="10" height="10"></rect>
</svg>
