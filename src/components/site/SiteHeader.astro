---
import BrandSymbol from './BrandSymbol.astro';

interface Props {
  current?: 'home' | 'serveis';
  /** Where "Contacte" points: the footer form on this page, or the home's on pages without one. */
  contactHref?: string;
}
const { current = 'home', contactHref = '#contacte' } = Astro.props;

const links = [
  { href: '/#projectes', label: 'Projectes' },
  { href: '/#experiencia', label: 'Experiència' },
  { href: '/serveis', label: 'Serveis', page: 'serveis' },
  { href: contactHref, label: 'Contacte' },
];
---
<!--
  The compact bar is 20px shorter (py-4 → py-1.5); mb-5 gives those 20px back to the flow, so the page
  does not jump up when the header shrinks and anchor targets land exactly under it.
  Sticky header. At the top of the page it is the full logo; once the page scrolls,
  `data-scrolled` turns it into a compact bar with a hairline underneath.
-->
<header
  data-site-header
  class="group sticky top-0 z-50 border-b border-line bg-paper transition-[background-color,border-color,margin] duration-300 data-[scrolled]:mb-5 data-[scrolled]:border-ink data-[scrolled]:bg-paper/95 data-[scrolled]:backdrop-blur-md"
>
  <div class="mx-auto flex max-w-[1200px] flex-wrap items-center justify-between gap-x-8 gap-y-1 px-6 py-4 transition-[padding] duration-300 sm:group-data-[scrolled]:flex-nowrap group-data-[scrolled]:gap-x-4 group-data-[scrolled]:py-1.5">
    <a href="/" class="flex min-h-11 items-center gap-3 text-ink" aria-label="Gerard Fortea, inici">
      <BrandSymbol class="h-auto w-11 transition-[width] duration-300 group-data-[scrolled]:w-9" stroke={4} />
      <span class="font-display text-[19px] leading-none font-medium tracking-[-0.02em] max-sm:group-data-[scrolled]:sr-only">Gerard Fortea</span>
    </a>
    <nav aria-label="Principal" class="flex flex-wrap gap-x-4 text-[14px] sm:gap-x-6 sm:text-[15px] sm:group-data-[scrolled]:flex-nowrap group-data-[scrolled]:gap-x-4 sm:group-data-[scrolled]:gap-x-6">
      {links.map(({ href, label, page }) => (
        <a
          href={href}
          aria-current={page === current ? 'page' : undefined}
          class:list={[
            'flex min-h-11 items-center border-b-2 hover:border-ink',
            page === current ? 'border-fageda text-ink' : 'border-transparent',
          ]}
        >{label}</a>
      ))}
    </nav>
  </div>
</header>

<script>
  const header = document.querySelector<HTMLElement>('[data-site-header]');
  if (header) {
    const root = document.documentElement;
    const update = () => header.toggleAttribute('data-scrolled', window.scrollY > 24);
    // Anchor targets must land just under the header as it looks once the page has scrolled: the compact
    // bar. Measure it whenever it is compact and settled (its padding transition takes 300ms).
    const measure = () => {
      if (header.hasAttribute('data-scrolled')) root.style.setProperty('--header-h', `${header.offsetHeight}px`);
    };
    update();
    measure();
    window.addEventListener('scroll', update, { passive: true });
    header.addEventListener('transitionend', measure);
    window.addEventListener('resize', () => {
      root.style.removeProperty('--header-h');
      measure();
    });
  }
</script>
