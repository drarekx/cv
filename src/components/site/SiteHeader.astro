---
interface Props {
  current?: 'home' | 'serveis';
}
const { current = 'home' } = Astro.props;

const links = [
  { href: '/#projectes', label: 'Projectes' },
  { href: '/#experiencia', label: 'Experiència' },
  { href: '/serveis', label: 'Serveis', page: 'serveis' },
  { href: '#contacte', label: 'Contacte' },
];
---
<!--
  Sticky header. At the top of the page it looks like the full header; once the page scrolls,
  `data-scrolled` switches it to a compact bar with a translucent background.
-->
<header
  data-site-header
  class="group sticky top-0 z-50 border-b border-transparent transition-[background-color,border-color] duration-300 data-[scrolled]:border-[#2a2d35] data-[scrolled]:bg-ink/95 data-[scrolled]:backdrop-blur-md"
>
  <div class="mx-auto flex max-w-[1200px] flex-wrap items-center justify-between gap-x-8 gap-y-1 px-6 py-5 transition-[padding] duration-300 group-data-[scrolled]:flex-nowrap group-data-[scrolled]:gap-x-4 group-data-[scrolled]:py-1.5">
    <a href="/" class="flex min-h-11 items-center gap-2.5 font-display text-lg font-bold transition-[font-size] duration-300 group-data-[scrolled]:text-base hover:text-acid">
      <span aria-hidden="true" class="h-3 w-3 rounded-full bg-acid transition-transform duration-300 group-data-[scrolled]:scale-75"></span>
      <span class="max-sm:group-data-[scrolled]:sr-only">Gerard Fortea</span>
    </a>
    <nav aria-label="Principal" class="flex flex-wrap gap-x-7 gap-y-0 text-sm font-medium transition-[font-size] duration-300 group-data-[scrolled]:flex-nowrap group-data-[scrolled]:gap-x-4 group-data-[scrolled]:text-[13px] sm:group-data-[scrolled]:gap-x-5">
      {links.map(({ href, label, page }) => (
        <a
          href={href}
          aria-current={page === current ? 'page' : undefined}
          class:list={['flex min-h-11 items-center hover:text-acid', page === current && 'text-acid underline decoration-2 underline-offset-8']}
        >{label}</a>
      ))}
    </nav>
  </div>
</header>

<script>
  const header = document.querySelector<HTMLElement>('[data-site-header]');
  if (header) {
    const update = () => header.toggleAttribute('data-scrolled', window.scrollY > 24);
    update();
    window.addEventListener('scroll', update, { passive: true });
  }
</script>
