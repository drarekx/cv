---
interface Props {
  current?: 'home' | 'serveis';
}
const { current = 'home' } = Astro.props;

const links = [
  { href: '/#projectes', label: 'Projectes' },
  { href: '/#experiencia', label: 'Experiència' },
  { href: '/serveis', label: 'Serveis', page: 'serveis' },
  { href: '#contacte', label: 'Contacte' },
];
---
<header class="mx-auto flex max-w-[1200px] flex-wrap items-center justify-between gap-x-8 gap-y-3 px-6 py-5">
  <a href="/" class="flex min-h-11 items-center gap-2.5 font-display text-lg font-bold hover:text-acid">
    <span aria-hidden="true" class="h-3 w-3 rounded-full bg-acid"></span>Gerard Fortea
  </a>
  <nav class="flex flex-wrap gap-x-7 gap-y-1 text-sm font-medium">
    {links.map(({ href, label, page }) => (
      <a
        href={href}
        aria-current={page === current ? 'page' : undefined}
        class:list={['flex min-h-11 items-center hover:text-acid', page === current && 'text-acid underline decoration-2 underline-offset-8']}
      >{label}</a>
    ))}
  </nav>
</header>
