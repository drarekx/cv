---
import BaseLayout from '../layouts/BaseLayout.astro';
// Self-hosted fonts (no request to Google): only the families this page uses.
import '@fontsource-variable/jetbrains-mono';
import '@fontsource-variable/space-grotesk';
import '@fontsource/roboto/400.css';
import '@fontsource/roboto-slab/400.css';
import '@fontsource/caveat/700.css';
import SiteHeader from '../components/site/SiteHeader.astro';
import ContactFooter from '../components/site/ContactFooter.astro';
import BrandSymbol from '../components/site/BrandSymbol.astro';
import { project } from '../data/projects';

const experience = [
  {
    role: 'Soci tecnològic i desenvolupador sènior full stack',
    period: '01/2025 – actualitat',
    company: 'Labsystems Arquitectura i Gestió',
    location: 'Barcelona',
    tasks: [
      'Retorn a l\'empresa on vaig treballar anys enrere, aquesta vegada assumint un rol més ampli com a analista i programador fullstack.',
      'Participació en projectes web principalment de l\'àmbit turístic, a més d\'altres sectors, cobrint tant el frontend com el backend.',
      'Anàlisi de requeriments, disseny de solucions i desenvolupament d\'aplicacions web a mida.',
    ],
  },
  {
    role: 'Desenvolupador sènior front-end',
    period: '02/2020 – 05/2023',
    company: 'Editorial Oceano',
    location: 'Barcelona',
    tasks: [
      'Anàlisi, desenvolupament i manteniment d\'aplicacions web destinades a la gestió d\'alumnes.',
      'Manteniment de llocs web.',
      'Suport en l\'anàlisi i desenvolupament del backend.',
    ],
  },
  {
    role: 'Programador web sènior full stack',
    period: '09/2017 – 02/2020',
    company: 'Labsystems Arquitectura i Gestió',
    location: 'Barcelona',
    tasks: [
      'Gestió, anàlisi i desenvolupament de diferents negocis online.',
      'Desenvolupament de software destinat al sector vacacional.',
    ],
  },
  {
    role: 'Desenvolupador d\'aplicacions web',
    period: '09/2013 – 09/2017',
    company: 'Gestión de Inmuebles Pimmo',
    location: 'Mataró',
    tasks: [
      'Manteniment i desenvolupament de software intern relacionat amb la gestió immobiliària.',
      'Manteniment d\'ordinadors.',
      'Manteniment dels diferents llocs web de l\'empresa.',
      'Referent tecnològic de l\'empresa.',
    ],
  },
  {
    role: 'Desenvolupador web junior',
    period: '01/2008 – 03/2010',
    company: 'Sala Assesors Informàtics',
    location: 'Mataró',
    tasks: [
      'Desenvolupament de pàgines corporatives i del sector educació amb software propi.',
      'Desenvolupament de diversos ecommerces amb EBD.',
      'Formació, manteniment i desenvolupament de funcionalitats per a software de gestió SAGE.',
      'Migració de VB6 a .NET d\'un software TPV destinat a la venda en botiga.',
    ],
  },
];

const education = [
  { period: '2024 – 2025', title: 'Tècnic superior en Desenvolupament d\'Aplicacions Web', center: 'IOC' },
  { period: '2004 – 2007', title: 'Tècnic superior en Informàtica de Gestió', center: 'Gesem' },
];

const skills = [
  { group: 'Desenvolupament', items: ['PHP', 'JavaScript', 'TypeScript', 'Java', 'Vue.js', 'HTML', 'CSS / Tailwind', 'MySQL', 'Swift'] },
  { group: 'Sistemes', items: ['Linux', 'macOS'] },
  { group: 'Gestió', items: ['Gestió de projectes', 'Anàlisi de projectes'] },
];

const languages = [
  { lang: 'Català', level: 'natiu' },
  { lang: 'Castellà', level: 'natiu' },
  { lang: 'Anglès', level: 'B1' },
];

const site = 'https://www.gerardfortea.com';
const personId = `${site}/#gerard`;

/** Kinds of professional work, with a 24px stroke icon each (inner SVG markup). */
const projectKinds = [
  { title: 'Webs educatives', text: 'Llocs web i eines per al sector de l\'educació.' },
  { title: 'Plataformes de gestió de la informació', text: 'Panells interns per ordenar dades, usuaris i processos.' },
  { title: 'Ecommerce', text: 'Botigues en línia: catàleg, comandes i pagaments.' },
  { title: 'Webs de turisme', text: 'Webs per a allotjaments i destinacions.' },
  { title: 'Motors de reserves', text: 'Disponibilitat, tarifes i reserves en línia.' },
  { title: 'Immobiliàries', text: 'Webs i eines per publicar i gestionar immobles.' },
  { title: 'Software de gestió de propietats', text: 'Propietats, propietaris, lloguers i manteniment.' },
  { title: 'I més', text: 'Webs corporatives, programari de gestió, TPV…' },
];

const ways = [
  { title: 'Eficient', text: 'Solucions que es poden mantenir, sense complicar el que és simple. Del requeriment a l\'aplicació en marxa.' },
  { title: 'Creatiu', text: 'Busco la manera més clara de resoldre cada problema, i vull que el resultat també es vegi bé.' },
  { title: 'Sociable i comunicatiu', text: 'Parlo amb qui farà servir l\'aplicació, no només amb qui l\'encarrega, i explico les decisions tècniques sense embolics.' },
  { title: 'Treballador', text: 'Més de 15 anys programant i en constant aprenentatge: sempre aprenent noves tecnologies.' },
];

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Person',
      '@id': personId,
      name: 'Gerard Fortea Castellsague',
      alternateName: 'Gerard Fortea',
      url: `${site}/`,
      jobTitle: 'Programador sènior fullstack',
      description: 'Programador sènior a la Garrotxa (Olot) especialitzat en aplicacions de gestió a mida amb les últimes tecnologies.',
      email: 'fortea.gerard@mail.com',
      telephone: '+34616271011',
      address: {
        '@type': 'PostalAddress',
        addressLocality: 'Maià de Montcal',
        addressRegion: 'la Garrotxa, Girona',
        addressCountry: 'ES',
      },
      homeLocation: { '@type': 'Place', name: 'Olot, la Garrotxa' },
      alumniOf: [
        { '@type': 'EducationalOrganization', name: 'Institut Obert de Catalunya (IOC)' },
        { '@type': 'EducationalOrganization', name: 'Gesem' },
      ],
      knowsAbout: [
        'Aplicacions de gestió a mida',
        'Desenvolupament web fullstack',
        'Intel·ligència artificial',
        'Vue.js', 'TypeScript', 'JavaScript', 'PHP', 'Laravel', 'MySQL', 'CSS', 'Swift',
        'Linux', 'macOS', 'Gestió de projectes', 'Anàlisi de projectes',
      ],
      knowsLanguage: ['ca', 'es', 'en'],
      sameAs: ['https://www.linkedin.com/in/gerard-fortea-a3863741/', 'https://github.com/drarekx'],
    },
    {
      '@type': 'WebSite',
      '@id': `${site}/#web`,
      url: `${site}/`,
      name: 'Gerard Fortea',
      inLanguage: 'ca',
      publisher: { '@id': personId },
    },
    {
      '@type': 'ProfilePage',
      '@id': `${site}/#perfil`,
      url: `${site}/`,
      name: 'Gerard Fortea — Programador sènior a la Garrotxa',
      inLanguage: 'ca',
      isPartOf: { '@id': `${site}/#web` },
      mainEntity: { '@id': personId },
    },
  ],
};

/** Open-source side projects, shown as a compact list under the websites. Add new ones here. */
const openSource = [
  { href: '/ledly', name: 'Ledly', version: project('ledly').version, swatch: '#38a8ff', text: 'Ambilight per al Mac i Windows: una tira de LEDs que segueix els colors de la pantalla.' },
  { href: '/wallpy', name: 'Wallpy', version: project('wallpy').version, swatch: '#f2a65a', text: 'Fons de pantalla amb vídeo per al Mac, que es posa en pausa quan no el veus.' },
  { href: '/atajoly', name: 'Atajoly', version: project('atajoly').version, swatch: '#ff6a3d', text: "Canvia d'app amb el polze: ⌘ dret i la inicial de l'app." },
  { href: '/terminaly', name: 'Terminaly', version: project('terminaly').version, swatch: '#6fdd8b', text: 'Tots els teus agents de terminal en una finestra, i un que dirigeix els altres en swarm.' },
];


const cardClass = 'group flex flex-col border border-ink bg-white text-ink no-underline';
const goClass = 'mt-2 self-start text-[15px] font-medium underline decoration-line decoration-2 underline-offset-[6px] group-hover:decoration-fageda';
---
<BaseLayout
  title="Gerard Fortea · Programador sènior a Olot · Aplicacions de gestió"
  description="Gerard Fortea, programador sènior a la Garrotxa (Olot) amb més de 15 anys d'experiència. Aplicacions de gestió a mida amb Vue, TypeScript, PHP i Laravel."
  bodyClass="bg-paper font-display text-ink antialiased"
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </Fragment>

  <SiteHeader current="home" />

  <main id="main" tabindex="-1" class="outline-none">
    <section id="inici" class="mx-auto max-w-[1200px] px-6 pt-16 pb-10">
      <div class="flex flex-wrap items-end gap-x-16 gap-y-10">
        <div class="flex min-w-0 flex-[1_1_600px] flex-col gap-7">
          <h1 class="flex flex-col gap-5 font-display font-medium">
            <span class="text-xl tracking-[-0.01em] text-graphite">Gerard Fortea, programador sènior a la Garrotxa</span>
            <span class="text-[clamp(46px,7.2vw,104px)] leading-[0.92] tracking-[-0.045em]">Aplicacions de gestió a mida</span>
          </h1>
          <p class="max-w-[600px] text-lg leading-relaxed text-graphite">
            Soc en <strong class="font-medium text-ink">Gerard Fortea</strong>, programador sènior a Olot i la Garrotxa amb més de 15 anys
            d'experiència. Desenvolupo <strong class="font-medium text-ink">aplicacions de gestió a mida</strong> per a empreses,
            escoles i entitats, amb Vue, TypeScript, PHP i Laravel.
          </p>
          <div class="flex flex-wrap gap-3">
            <a href="#contacte" class="flex min-h-[52px] items-center bg-ink px-7 text-[15px] font-medium text-paper hover:bg-fageda hover:text-ink">Explica'm el teu projecte</a>
            <a href="#experiencia" class="flex min-h-[52px] items-center border border-ink px-7 text-[15px] font-medium hover:bg-ink hover:text-paper">Llegir el CV</a>
          </div>
        </div>
        <dl class="m-0 flex-[0_1_330px] border-t border-ink text-[15px]">
          {[
            ['Rol', 'Programador sènior fullstack'],
            ['Especialitat', 'Aplicacions de gestió'],
            ['Projectes', 'Més de 50'],
            ['Base', 'Olot, la Garrotxa'],
            ['Idiomes', 'Català, castellà, anglès'],
          ].map(([k, v]) => (
            <div class="grid grid-cols-[120px_1fr] border-b border-line py-2.5">
              <dt class="text-graphite">{k}</dt><dd>{v}</dd>
            </div>
          ))}
        </dl>
      </div>

      <!-- The brand relief: three volcanic ridges of la Garrotxa that become circuit traces and end in
           pads. Each pad is a way into the page; hovering a link lights its trace. -->
      <nav aria-label="Què faig" class="relief relative mt-14">
        <svg class="block h-auto w-full" viewBox="0 0 1200 320" fill="none" stroke-linecap="square" stroke-linejoin="miter" aria-hidden="true">
          <path class="trace t1" pathLength="1" d="M0 300 L 90 250 L 170 160 L 205 118 L 222 134 L 240 116 L 300 186 L 340 200 H 700 L 780 120 H 1150"></path>
          <path class="trace t2" pathLength="1" d="M300 300 L 380 252 L 420 222 L 432 214 L 444 222 L 470 236 L 520 262 H 800 L 872 190 H 1150"></path>
          <path class="trace t3" pathLength="1" d="M0 300 H 900 L 940 260 H 1150"></path>
          <rect class="pad t1" x="1150" y="112" width="16" height="16"></rect>
          <rect class="pad t2" x="1150" y="182" width="16" height="16"></rect>
          <rect class="pad t3" x="1150" y="252" width="16" height="16"></rect>
        </svg>
        <ul class="flex flex-col border-t border-line text-lg font-medium md:contents">
          <li class="md:absolute md:top-[37.5%] md:right-[6%] md:-translate-y-full"><a class="r1 flex min-h-12 items-center border-b border-line md:min-h-0 md:border-0 md:pb-2 md:underline md:decoration-transparent md:decoration-2 md:underline-offset-[6px] hover:decoration-fageda" href="#gestio">Aplicacions de gestió</a></li>
          <li class="md:absolute md:top-[59.4%] md:right-[6%] md:-translate-y-full"><a class="r2 flex min-h-12 items-center border-b border-line md:min-h-0 md:border-0 md:pb-2 md:underline md:decoration-transparent md:decoration-2 md:underline-offset-[6px] hover:decoration-violeta" href="#webs">Webs per a entitats</a></li>
          <li class="md:absolute md:top-[81.2%] md:right-[6%] md:-translate-y-full"><a class="r3 flex min-h-12 items-center border-b border-line md:min-h-0 md:border-0 md:pb-2 md:underline md:decoration-transparent md:decoration-2 md:underline-offset-[6px] hover:decoration-lava" href="#apps">Apps per al Mac</a></li>
        </ul>
      </nav>
    </section>

    <section id="gestio" aria-labelledby="gestio-titol" class="mx-auto flex max-w-[1200px] flex-col gap-14 px-6 pt-24 pb-24">
      <div class="flex flex-wrap gap-x-16 gap-y-10">
        <div class="flex min-w-0 flex-[1_1_480px] flex-col gap-5">
          <h2 id="gestio-titol" class="font-display text-[clamp(34px,4.4vw,58px)] leading-[1] font-medium tracking-[-0.03em]">
            Aplicacions de gestió que es fan servir cada dia
          </h2>
          <p class="max-w-[600px] text-lg leading-relaxed text-graphite">
            Fa anys que faig el programari amb què treballa la gent: panells interns, gestió de clients, reserves i processos
            que abans es feien a mà. Pensat per a qui l'utilitzarà, fàcil de mantenir i fet amb tecnologies actuals.
          </p>
        </div>
        <ul class="flex flex-[1_1_380px] flex-col gap-6 pt-2 text-[16px] leading-relaxed text-graphite">
          <li class="flex gap-4"><span aria-hidden="true" class="mt-2 h-2.5 w-2.5 shrink-0 bg-fageda"></span><span><strong class="font-medium text-ink">Gestió a mida.</strong> Gestió d'alumnes a Editorial Océano, gestió immobiliària a Pimmo i programari per al sector turístic i vacacional a Labsystems.</span></li>
          <li class="flex gap-4"><span aria-hidden="true" class="mt-2 h-2.5 w-2.5 shrink-0 bg-violeta"></span><span><strong class="font-medium text-ink">Panells per a gent no tècnica.</strong> L'organització del <a href="/combat-glosa" class="text-ink underline decoration-violeta decoration-2 underline-offset-4">Combat de Glosa</a> canvia continguts, colors i formularis sense tocar codi.</span></li>
          <li class="flex gap-4"><span aria-hidden="true" class="mt-2 h-2.5 w-2.5 shrink-0 bg-lava"></span><span><strong class="font-medium text-ink">Al dia.</strong> Quan estalvia feina, hi afegeixo intel·ligència artificial, com els assistents del backend del <a href="/casino-tortella" class="text-ink underline decoration-lava decoration-2 underline-offset-4">Casino de Tortellà</a>.</span></li>
        </ul>
      </div>
      <div class="flex flex-col gap-8">
        <h3 class="font-display text-2xl font-medium tracking-[-0.02em]">Com treballo</h3>
        <dl class="grid gap-x-12 gap-y-8 sm:grid-cols-2">
          {ways.map((w) => (
            <div class="flex flex-col gap-2">
              <dt class="font-display text-xl font-medium">{w.title}</dt>
              <dd class="max-w-[46ch] text-[16px] leading-relaxed text-graphite">{w.text}</dd>
            </div>
          ))}
        </dl>
      </div>
    </section>

    <section id="projectes" aria-labelledby="projectes-titol" class="border-y border-ink bg-white">
      <div class="mx-auto flex max-w-[1200px] flex-col gap-12 px-6 pt-24 pb-24">
        <div class="flex flex-col gap-5">
          <h2 id="projectes-titol" class="max-w-[16ch] font-display text-[clamp(34px,4.4vw,58px)] leading-[1] font-medium tracking-[-0.03em]">
            Més de 50 projectes professionals
          </h2>
          <p class="max-w-[620px] text-lg leading-relaxed text-graphite">
            En més de 15 anys, a Labsystems, Editorial Océano, Pimmo i Sala Assessors, he desenvolupat projectes de tota mena.
          </p>
        </div>
        <ul class="grid gap-x-12 gap-y-7 sm:grid-cols-2 lg:grid-cols-4">
          {projectKinds.map((k) => (
            <li class="flex flex-col gap-1.5 border-t border-ink pt-3">
              <h3 class="font-display text-lg leading-tight font-medium">{k.title}</h3>
              <p class="text-[15px] leading-relaxed text-graphite">{k.text}</p>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <!-- Featured project: the newest and biggest personal one. -->
    <section id="canconers" aria-labelledby="canconers-titol" class="mx-auto max-w-[1200px] px-6 pt-24">
      <div class="grid items-center gap-x-14 gap-y-10 lg:grid-cols-[minmax(0,5fr)_minmax(0,7fr)]">
        <div class="flex flex-col gap-5">
          <p class="text-[15px] text-graphite">L'últim projecte personal</p>
          <h2 id="canconers-titol" class="font-display text-[clamp(34px,4.4vw,58px)] leading-[1] font-medium tracking-[-0.03em]">Cançoners</h2>
          <p class="max-w-[520px] text-lg leading-relaxed text-graphite">
            Una app per al Mac per dissenyar cançoners amb lletra, acords i diagrames, i imprimir-los com un llibret A5 a punt
            per plegar i cosir. Editor de pàgines, biblioteca de cançons amb versions, transport d'acords i PDF per a impremta.
          </p>
          <p class="flex flex-wrap gap-x-5 font-mono text-xs text-graphite"><span>Python, Flask, Vue 3, Pinia, Tiptap</span><span>{project('canconers').version}</span></p>
          <div class="flex flex-wrap items-center gap-x-6 gap-y-3">
            <a href="/canconers" class="flex min-h-[52px] items-center bg-ink px-7 text-[15px] font-medium text-paper hover:bg-fageda hover:text-ink">Veure Cançoners</a>
            <a href={project('canconers').repo} class="flex min-h-11 items-center text-[15px] font-medium underline decoration-line decoration-2 underline-offset-[6px] hover:decoration-fageda">Codi a GitHub</a>
          </div>
        </div>
        <a href="/canconers" class="block border border-ink bg-white p-2" tabindex="-1" aria-hidden="true">
          <img
            src="/img/canconers-editor-1600.webp"
            srcset="/img/canconers-editor-960.webp 960w, /img/canconers-editor-1600.webp 1600w"
            sizes="(min-width: 1200px) 660px, (min-width: 1024px) 56vw, 100vw"
            width="1600" height="1000" alt="" loading="lazy" decoding="async" class="block h-auto w-full"
          />
        </a>
      </div>
    </section>

    <section id="webs" aria-labelledby="webs-titol" class="mx-auto flex max-w-[1200px] flex-col gap-10 px-6 pt-24 pb-20">
      <div class="flex flex-wrap items-end justify-between gap-x-12 gap-y-4">
        <h2 id="webs-titol" class="font-display text-[clamp(34px,4.4vw,58px)] leading-[1] font-medium tracking-[-0.03em]">Webs per a entitats i companyies</h2>
        <p class="max-w-[420px] leading-relaxed text-graphite">El Casino de Tortellà, el seu combat de glosa i una companyia de circ. Aviat n'hi haurà més.</p>
      </div>
      <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
        <a href="/casino-tortella" class={cardClass}>
          <div aria-hidden="true" class="flex h-[260px] flex-col bg-white font-roboto text-[#1c1c1c]">
            <div class="flex h-9 items-center gap-2 bg-[#1c1c1c] px-4 font-slab text-sm text-white">
              <svg viewBox="0 0 24 22" class="h-3.5 w-3.5"><path d="M12 0 24 22H0Z" fill="#55d8d2"></path></svg>Casino de Tortellà
            </div>
            <div class="flex items-end justify-between gap-4 bg-[#55d8d2] px-5 py-4">
              <div class="font-slab text-xl leading-tight">5è Combat de Glosa<br />de Tortellà</div>
              <div class="text-right font-slab text-4xl leading-none">21<span class="block text-xs uppercase">nov</span></div>
            </div>
            <div class="flex items-center gap-4 border-b border-[#c3c8cf] px-5 py-2.5"><span class="w-8 font-slab text-2xl">15</span><span class="font-slab">Mostra de Cinema Espiritual</span></div>
            <div class="flex items-center gap-4 border-b border-[#c3c8cf] px-5 py-2.5"><span class="w-8 font-slab text-2xl">31</span><span class="font-slab">Festa de la Castanyada</span></div>
          </div>
          <div class="flex grow flex-col gap-3 border-t border-ink p-6">
            <div class="flex items-baseline justify-between gap-3">
              <h3 class="font-display text-[26px] font-medium tracking-[-0.02em]">Casino de Tortellà</h3>
              <span class="font-mono text-xs text-graphite">October CMS</span>
            </div>
            <p class="grow text-[15px] leading-relaxed text-graphite">La nova web de l'entitat: agenda d'actes, espais, activitats setmanals i fer-se'n soci. Una cartellera on el programa mana.</p>
            <span class={goClass}>Veure el projecte</span>
          </div>
        </a>

        <a href="/combat-glosa" class={cardClass}>
          <div aria-hidden="true" class="flex h-[260px] items-center justify-center bg-[repeating-linear-gradient(90deg,#f4a3b9_0_46px,#8fd94a_46px_52px,#f4a3b9_52px_96px)] p-6">
            <div class="flex flex-col items-center gap-2 border-[3px] border-[#111111] bg-[#fdf6ec] px-6 py-4 text-center text-[#111111] shadow-[6px_6px_0_#111111]">
              <span class="font-hand text-[34px] leading-none font-bold text-[#e5006d]">Combat de Glosa</span>
              <span class="text-xs font-bold">21 de novembre · 16:30h</span>
              <span class="flex gap-1.5 text-white">
                <span class="bg-[#111111] px-2 py-1 text-xs font-bold"><span class="text-[#ff2e88]" data-glosa-days>--</span> dies</span>
                <span class="bg-[#111111] px-2 py-1 text-xs font-bold">Casino de Tortellà</span>
              </span>
            </div>
          </div>
          <div class="flex grow flex-col gap-3 border-t border-ink p-6">
            <div class="flex items-baseline justify-between gap-3">
              <h3 class="font-display text-[26px] font-medium tracking-[-0.02em]">Combat de Glosa</h3>
              <span class="font-mono text-xs text-graphite">Nuxt 4</span>
            </div>
            <p class="grow text-[15px] leading-relaxed text-graphite">La web del combat de glosa i corrandes: programa, reserves del dinar, inscripció de glosadors i un panell per canviar-ho tot.</p>
            <span class={goClass}>Veure el projecte</span>
          </div>
        </a>

        <a href="https://www.cianomprovisional.com/" target="_blank" rel="noopener" class={cardClass}>
          <div aria-hidden="true" class="relative flex h-[260px] flex-col items-center justify-center gap-3 overflow-hidden bg-[#3d8fd4] text-white">
            <picture>
