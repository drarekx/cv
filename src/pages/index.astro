              <img src="/img/cia-nom-provisional-bg-800.jpg" alt="" width="800" height="398" loading="lazy" decoding="async" class="absolute inset-x-0 top-9 bottom-0 h-[calc(100%-2.25rem)] w-full object-cover object-top" />
