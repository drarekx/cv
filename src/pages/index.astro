---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from '../components/site/SiteHeader.astro';
import ContactFooter from '../components/site/ContactFooter.astro';
import { project } from '../data/projects';

const experience = [
  {
    role: 'Desenvolupador senior Full Stack',
    period: '01/2025 – actualitat',
    company: 'Labsystems Arquitectura i Gestió',
    location: 'Barcelona',
    tasks: [
      'Retorn a l\'empresa on vaig treballar anys enrere, aquesta vegada assumint un rol més ampli com a analista i programador fullstack.',
      'Participació en projectes web principalment de l\'àmbit turístic, a més d\'altres sectors, cobrint tant el frontend com el backend.',
      'Anàlisi de requeriments, disseny de solucions i desenvolupament d\'aplicacions web a mida.',
    ],
  },
  {
    role: 'Desenvolupador senior Front-end',
    period: '02/2020 – 05/2023',
    company: 'Editorial Oceano',
    location: 'Barcelona',
    tasks: [
      'Anàlisi, desenvolupament i manteniment d\'aplicacions web destinades a la gestió d\'alumnes.',
      'Manteniment de llocs web.',
      'Suport en l\'anàlisi i desenvolupament del backend.',
    ],
  },
  {
    role: 'Programador web senior FullStack',
    period: '09/2017 – 02/2020',
    company: 'Labsystems Arquitectura i Gestió',
    location: 'Barcelona',
    tasks: [
      'Gestió, anàlisi i desenvolupament de diferents negocis online.',
      'Desenvolupament de software destinat al sector vacacional.',
    ],
  },
  {
    role: 'Desenvolupador d\'aplicacions web',
    period: '09/2013 – 09/2017',
    company: 'Gestión de Inmuebles Pimmo',
    location: 'Mataró',
    tasks: [
      'Manteniment i desenvolupament de software intern relacionat amb la gestió immobiliària.',
      'Manteniment d\'ordinadors.',
      'Manteniment dels diferents llocs web de l\'empresa.',
      'Referent tecnològic de l\'empresa.',
    ],
  },
  {
    role: 'Desenvolupador web junior',
    period: '01/2008 – 03/2010',
    company: 'Sala Assesors Informàtics',
    location: 'Mataró',
    tasks: [
      'Desenvolupament de pàgines corporatives i del sector educació amb software propi.',
      'Desenvolupament de diversos ecommerces amb EBD.',
      'Formació, manteniment i desenvolupament de funcionalitats per a software de gestió SAGE.',
      'Migració de VB6 a .NET d\'un software TPV destinat a la venda en botiga.',
    ],
  },
];

const education = [
  { period: '2024 – 2025', title: 'Tècnic superior en Desenvolupament d\'Aplicacions Web', center: 'IOC' },
  { period: '2004 – 2007', title: 'Tècnic superior en Informàtica de Gestió', center: 'Gesem' },
];

const skills = ['PHP', 'JavaScript', 'TypeScript', 'Java', 'Vue.js', 'HTML', 'CSS / Tailwind', 'MySQL'];

const languages = [
  { lang: 'Català', level: 'natiu' },
  { lang: 'Castellà', level: 'natiu' },
  { lang: 'Anglès', level: 'B1' },
];

const site = 'https://www.gerardfortea.com';
const personId = `${site}/#gerard`;

const ways = [
  { title: 'Eficient', text: 'Solucions que es poden mantenir, sense complicar el que és simple. Del requeriment a l\'aplicació en marxa, sense voltes.' },
  { title: 'Creatiu', text: 'Busco la manera més clara de resoldre cada problema, i vull que el resultat també es vegi bé. Per gust, faig apps per al Mac.' },
  { title: 'Sociable i comunicatiu', text: 'Parlo amb qui farà servir l\'aplicació, no només amb qui l\'encarrega, i explico les decisions tècniques sense embolics.' },
  { title: 'Treballador', text: 'Més de 15 anys programant i continuo estudiant: el 2025 vaig acabar el cicle superior de Desenvolupament d\'Aplicacions Web.' },
];

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Person',
      '@id': personId,
      name: 'Gerard Fortea Castellsague',
      alternateName: 'Gerard Fortea',
      url: `${site}/`,
      jobTitle: 'Programador web fullstack',
      description: 'Programador a la Garrotxa (Olot) especialitzat en aplicacions de gestió a mida amb les últimes tecnologies.',
      email: 'mailto:fortea.gerard@mail.com',
      telephone: '+34616271011',
      address: {
        '@type': 'PostalAddress',
        addressLocality: 'Maià de Montcal',
        addressRegion: 'la Garrotxa, Girona',
        addressCountry: 'ES',
      },
      homeLocation: { '@type': 'Place', name: 'Olot, la Garrotxa' },
      worksFor: { '@type': 'Organization', name: 'Labsystems Arquitectura i Gestió' },
      alumniOf: [
        { '@type': 'EducationalOrganization', name: 'Institut Obert de Catalunya (IOC)' },
        { '@type': 'EducationalOrganization', name: 'Gesem' },
      ],
      knowsAbout: [
        'Aplicacions de gestió a mida',
        'Desenvolupament web fullstack',
        'Intel·ligència artificial',
        'Vue.js', 'TypeScript', 'JavaScript', 'PHP', 'Laravel', 'MySQL', 'Swift',
      ],
      knowsLanguage: ['ca', 'es', 'en'],
      sameAs: ['https://www.linkedin.com/in/gerard-fortea-a3863741/', 'https://github.com/drarekx'],
    },
    {
      '@type': 'WebSite',
      '@id': `${site}/#web`,
      url: `${site}/`,
      name: 'Gerard Fortea',
      inLanguage: 'ca',
      publisher: { '@id': personId },
    },
    {
      '@type': 'ProfilePage',
      '@id': `${site}/#perfil`,
      url: `${site}/`,
      name: 'Gerard Fortea — Programador a la Garrotxa',
      inLanguage: 'ca',
      isPartOf: { '@id': `${site}/#web` },
      mainEntity: { '@id': personId },
    },
  ],
};

const wallpy = project('wallpy');
const atajoly = project('atajoly');
const terminaly = project('terminaly');

const cardClass = 'group flex flex-col overflow-hidden rounded-3xl border border-[#2a2d35] bg-[#17191e] text-paper no-underline transition duration-300 hover:-translate-y-2 hover:border-acid';
const goClass = 'mt-1.5 flex min-h-11 items-center self-start rounded-full border border-[#4a4e59] px-[18px] text-sm font-semibold transition-colors group-hover:border-acid group-hover:bg-acid group-hover:text-ink';
---
<BaseLayout
  title="Gerard Fortea — Programador a la Garrotxa · Aplicacions de gestió a mida"
  description="Gerard Fortea, programador a la Garrotxa (Olot). Desenvolupo aplicacions de gestió a mida amb les últimes tecnologies. Eficient, creatiu, comunicatiu i treballador."
  fonts="Inter:wght@400;500;600&family=JetBrains+Mono:wght@400;700&family=Sora:wght@600&family=Space+Grotesk:wght@500;600;700&family=Roboto+Slab:wght@400&family=Roboto:wght@400&family=Caveat:wght@700"
  bodyClass="bg-ink font-sans text-paper antialiased"
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </Fragment>

  <SiteHeader current="home" />

  <main>
    <section id="inici" class="mx-auto flex max-w-[1200px] flex-wrap items-end gap-x-16 gap-y-10 px-6 pt-[72px] pb-[72px]">
      <div class="flex min-w-0 flex-[1_1_560px] flex-col gap-[22px]">
        <h1 class="flex flex-col gap-4 font-display text-[clamp(40px,6.4vw,88px)] leading-none font-bold tracking-[-0.03em]">
          <span class="font-mono text-[15px] leading-normal font-normal tracking-normal text-acid">Gerard Fortea · programador a la Garrotxa</span>
          <span>Aplicacions de gestió <span class="text-acid">a mida.</span></span>
        </h1>
        <p class="max-w-[640px] text-lg text-[#b4b6bd]">
          Sóc en <strong class="font-semibold text-paper">Gerard Fortea</strong>, programador web a Olot i la Garrotxa amb més de 15 anys
          d'experiència. Desenvolupo <strong class="font-semibold text-paper">aplicacions de gestió a mida</strong> per a empreses,
          escoles i entitats, amb les últimes tecnologies: Vue, TypeScript, PHP i Laravel.
        </p>
        <div class="mt-2 flex flex-wrap gap-3">
          <a href="#projectes" class="flex min-h-[52px] items-center rounded-full bg-acid px-[26px] text-[15px] font-semibold text-ink hover:bg-white">Veure els projectes</a>
          <a href="#experiencia" class="flex min-h-[52px] items-center rounded-full border border-[#4a4e59] px-[26px] text-[15px] font-semibold hover:border-paper">Llegir el CV</a>
        </div>
      </div>
      <dl class="m-0 grid flex-[0_1_340px] grid-cols-[auto_1fr] gap-x-[18px] gap-y-2 rounded-[20px] border border-[#2a2d35] bg-[#17191e] p-[22px] font-mono text-[13px]">
        <dt class="text-[#9a9da6]">rol</dt><dd>senior fullstack</dd>
        <dt class="text-[#9a9da6]">fort</dt><dd>aplicacions de gestió</dd>
        <dt class="text-[#9a9da6]">ara</dt><dd>Labsystems, des de 2025</dd>
        <dt class="text-[#9a9da6]">web</dt><dd>PHP · TS · Vue · MySQL</dd>
        <dt class="text-[#9a9da6]">mac</dt><dd>Swift · AppKit · SwiftUI</dd>
        <dt class="text-[#9a9da6]">idiomes</dt><dd>ca · es · en</dd>
      </dl>
    </section>

    <section id="gestio" aria-labelledby="gestio-titol" class="mx-auto flex max-w-[1200px] flex-col gap-10 px-6 pt-6 pb-[88px]">
      <div class="flex flex-wrap gap-x-16 gap-y-8">
        <div class="flex min-w-0 flex-[1_1_480px] flex-col gap-4">
          <h2 id="gestio-titol" class="font-display text-[clamp(32px,4vw,52px)] leading-[1.05] font-bold tracking-[-0.02em]">
            Aplicacions de gestió que es fan servir cada dia
          </h2>
          <p class="max-w-[600px] text-lg text-[#b4b6bd]">
            Fa anys que faig el programari amb què treballa la gent: panells interns, gestió de clients, reserves i processos
            que abans es feien a mà. Pensat per a qui l'utilitzarà, fàcil de mantenir i fet amb tecnologies actuals.
          </p>
        </div>
        <ul class="flex flex-[1_1_380px] flex-col gap-4 text-[15px] text-[#b4b6bd]">
          <li class="flex gap-3"><span aria-hidden="true" class="mt-2 h-2 w-2 shrink-0 rounded-full bg-acid"></span><span><strong class="font-semibold text-paper">Gestió a mida.</strong> Gestió d'alumnes a Editorial Océano, gestió immobiliària a Pimmo i programari per al sector turístic i vacacional a Labsystems.</span></li>
          <li class="flex gap-3"><span aria-hidden="true" class="mt-2 h-2 w-2 shrink-0 rounded-full bg-acid"></span><span><strong class="font-semibold text-paper">Panells per a gent no tècnica.</strong> L'organització del <a href="/combat-glosa" class="text-acid underline underline-offset-4">Combat de Glosa</a> canvia continguts, colors i formularis sense tocar codi.</span></li>
          <li class="flex gap-3"><span aria-hidden="true" class="mt-2 h-2 w-2 shrink-0 rounded-full bg-acid"></span><span><strong class="font-semibold text-paper">Al dia.</strong> Quan estalvia feina, hi afegeixo intel·ligència artificial, com els assistents del backend del <a href="/casino-tortella" class="text-acid underline underline-offset-4">Casino de Tortellà</a>.</span></li>
        </ul>
      </div>
      <div class="flex flex-col gap-5">
        <h3 class="font-display text-2xl font-bold">Com treballo</h3>
        <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
          {ways.map((w) => (
            <article class="flex flex-col gap-2 rounded-[20px] border border-[#2a2d35] bg-[#17191e] p-6">
              <h4 class="font-display text-xl font-bold text-acid">{w.title}</h4>
              <p class="text-[15px] text-[#b4b6bd]">{w.text}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section id="projectes" class="mx-auto flex max-w-[1200px] flex-col gap-8 px-6 pt-6 pb-[88px]">
      <div class="flex flex-wrap items-end justify-between gap-x-12 gap-y-3">
        <h2 class="font-display text-[clamp(32px,4vw,52px)] leading-[1.05] font-bold tracking-[-0.02em]">Tres apps per al Mac, <span class="text-acid">per gust</span></h2>
        <p class="max-w-[460px] text-[#b4b6bd]">Natives, escrites en Swift i publicades a GitHub. S'instal·len amb una línia a Terminal i s'actualitzen soles.</p>
      </div>
      <div class="grid grid-cols-[repeat(auto-fit,minmax(300px,1fr))] gap-6">

        <a href="/wallpy" class={cardClass}>
          <div aria-hidden="true" class="relative h-[260px] overflow-hidden bg-[#f2a65a]">
            <div class="absolute top-[30%] left-[62%] h-[84px] w-[84px] rounded-full bg-[#ffe2a6]"></div>
            <div class="absolute top-12 left-0 h-[22px] w-[120px] rounded-full bg-[#f7c592] [animation:drift_26s_linear_infinite]"></div>
            <div class="absolute top-[92px] left-0 h-4 w-20 rounded-full bg-[#f7c592] [animation:drift_38s_linear_infinite_-12s]"></div>
            <svg viewBox="0 0 400 120" preserveAspectRatio="none" class="absolute bottom-0 left-0 h-[130px] w-full">
              <path d="M0 70 Q80 10 170 60 T400 40 V120 H0Z" fill="#a8502f"></path>
              <path d="M0 95 Q110 50 220 90 T400 78 V120 H0Z" fill="#6e2f25"></path>
            </svg>
            <div class="absolute inset-x-0 top-0 flex h-6 items-center justify-between bg-[#2a1208] px-3 font-sora text-[11px] text-[#ffe2a6]">
              <span>Wallpy</span><span data-clock>--:--</span>
            </div>
            <div class="absolute bottom-3.5 left-[18px] font-sora text-5xl leading-none font-semibold text-white" data-clock>--:--</div>
          </div>
          <div class="flex grow flex-col gap-2.5 p-6">
            <div class="flex items-baseline justify-between gap-3">
              <h3 class="font-display text-[26px] font-bold">Wallpy</h3>
              <span class="font-mono text-xs text-[#9a9da6]">{wallpy.version}</span>
            </div>
            <p class="grow text-[15px] text-[#b4b6bd]">Fons de pantalla amb vídeo. Un bucle darrere les finestres que es posa en pausa quan no el veus.</p>
            <span class={goClass}>Obrir Wallpy →</span>
          </div>
        </a>

        <a href="/atajoly" class={cardClass}>
          <div aria-hidden="true" class="flex h-[260px] flex-col items-center justify-center gap-[18px] bg-[#ecebe6]">
            <div class="flex items-center gap-3 font-mono font-bold text-[#1c1b19]">
              <div class="box-border flex h-[72px] w-[104px] flex-col items-end justify-between rounded-xl border-b-[5px] border-[#c2441d] bg-[#ff6a3d] px-2.5 py-2 text-xs">
                <span class="text-xl">⌘</span><span>dret</span>
              </div>
              <span class="text-[22px]">+</span>
              <div class="animate-press box-border flex h-[72px] w-[72px] items-center justify-center rounded-xl border border-b-[5px] border-[#cfcdc4] border-b-[#b9b6ab] bg-white text-3xl" data-key-letter>S</div>
            </div>
            <div class="font-display text-lg font-semibold text-[#1c1b19]">→ <span data-key-app>Safari</span> al davant</div>
          </div>
          <div class="flex grow flex-col gap-2.5 p-6">
            <div class="flex items-baseline justify-between gap-3">
              <h3 class="font-display text-[26px] font-bold">Atajoly</h3>
              <span class="font-mono text-xs text-[#9a9da6]">{atajoly.version}</span>
            </div>
            <p class="grow text-[15px] text-[#b4b6bd]">Canvia d'app amb el polze. Mantén ⌘ dret, prem la inicial d'una app i es posa davant.</p>
            <span class={goClass}>Obrir Atajoly →</span>
          </div>
        </a>

        <a href="/terminaly" class={cardClass}>
          <div aria-hidden="true" class="box-border flex h-[260px] flex-col gap-2.5 bg-[#050608] p-5 font-mono text-xs text-[#c9d1d9]">
            <div class="text-[#8b949e]">$ tly ls</div>
            <div class="flex gap-2.5"><span class="text-[#f2b84b]">●</span><span class="grow">claude · migració</span><span class="text-[#f2b84b]">treballant</span></div>
            <div class="flex gap-2.5"><span class="text-[#6fdd8b]">●</span><span class="grow">codex · tests</span><span class="text-[#6fdd8b]">a punt</span></div>
            <div class="flex gap-2.5"><span class="text-[#7ab7ff]">●</span><span class="grow">claude · rutes</span><span class="text-[#7ab7ff]">et necessita</span></div>
            <div class="flex gap-2.5"><span class="text-[#6fdd8b]">●</span><span class="grow">zsh</span><span class="text-[#6fdd8b]">a punt</span></div>
            <div class="mt-auto">$ <span class="animate-blink inline-block h-[15px] w-2 bg-[#6fdd8b] align-text-bottom"></span></div>
          </div>
          <div class="flex grow flex-col gap-2.5 p-6">
            <div class="flex items-baseline justify-between gap-3">
              <h3 class="font-display text-[26px] font-bold">Terminaly</h3>
              <span class="font-mono text-xs text-[#9a9da6]">{terminaly.version}</span>
            </div>
            <p class="grow text-[15px] text-[#b4b6bd]">Tots els teus agents, un sol terminal. Sessions de Claude, Codex i shell que segueixen vives encara que tanquis l'app.</p>
            <span class={goClass}>Obrir Terminaly →</span>
          </div>
        </a>

      </div>
    </section>

    <section id="webs" class="mx-auto flex max-w-[1200px] flex-col gap-8 px-6 pb-[88px]">
      <div class="flex flex-wrap items-end justify-between gap-x-12 gap-y-3">
        <h2 class="font-display text-[clamp(32px,4vw,52px)] leading-[1.05] font-bold tracking-[-0.02em]">I dues webs per a Tortellà</h2>
        <p class="max-w-[460px] text-[#b4b6bd]">Per a la gent del poble i de la vall: l'entitat cultural de 1869 i el seu combat de glosa.</p>
      </div>
      <div class="grid gap-6 md:grid-cols-2">

        <a href="/casino-tortella" class={cardClass}>
          <div aria-hidden="true" class="flex h-[260px] flex-col bg-white font-roboto text-[#1c1c1c]">
            <div class="flex h-9 items-center gap-2 bg-[#1c1c1c] px-4 font-slab text-sm text-white">
              <svg viewBox="0 0 24 22" class="h-3.5 w-3.5"><path d="M12 0 24 22H0Z" fill="#55d8d2"></path></svg>Casino de Tortellà
            </div>
            <div class="flex items-end justify-between gap-4 bg-[#55d8d2] px-5 py-4">
              <div class="font-slab text-xl leading-tight">5è Combat de Glosa<br />de Tortellà</div>
              <div class="text-right font-slab text-4xl leading-none">21<span class="block text-xs uppercase">nov</span></div>
            </div>
            <div class="flex items-center gap-4 border-b border-[#c3c8cf] px-5 py-2.5"><span class="w-8 font-slab text-2xl">15</span><span class="font-slab">Mostra de Cinema Espiritual</span></div>
            <div class="flex items-center gap-4 border-b border-[#c3c8cf] px-5 py-2.5"><span class="w-8 font-slab text-2xl">31</span><span class="font-slab">Festa de la Castanyada</span></div>
          </div>
          <div class="flex grow flex-col gap-2.5 p-6">
            <div class="flex items-baseline justify-between gap-3">
              <h3 class="font-display text-[26px] font-bold">Casino de Tortellà</h3>
              <span class="font-mono text-xs text-[#9a9da6]">October CMS</span>
            </div>
            <p class="grow text-[15px] text-[#b4b6bd]">La nova web de l'entitat: agenda d'actes, espais, activitats setmanals i fer-se'n soci. Una cartellera on el programa mana.</p>
            <span class={goClass}>Obrir Casino →</span>
          </div>
        </a>

        <a href="/combat-glosa" class={cardClass}>
          <div aria-hidden="true" class="flex h-[260px] items-center justify-center bg-[repeating-linear-gradient(90deg,#f4a3b9_0_46px,#8fd94a_46px_52px,#f4a3b9_52px_96px)] p-6">
            <div class="flex flex-col items-center gap-2 border-[3px] border-[#111111] bg-[#fdf6ec] px-6 py-4 text-center text-[#111111] shadow-[6px_6px_0_#111111]">
              <span class="font-hand text-[34px] leading-none font-bold text-[#e5006d]">Combat de Glosa</span>
              <span class="text-xs font-bold">21 de novembre · 16:30h</span>
              <span class="flex gap-1.5 text-white">
                <span class="bg-[#111111] px-2 py-1 text-xs font-bold"><span class="text-[#ff2e88]" data-glosa-days>--</span> dies</span>
                <span class="bg-[#111111] px-2 py-1 text-xs font-bold">Casino de Tortellà</span>
              </span>
            </div>
          </div>
          <div class="flex grow flex-col gap-2.5 p-6">
            <div class="flex items-baseline justify-between gap-3">
              <h3 class="font-display text-[26px] font-bold">Combat de Glosa</h3>
              <span class="font-mono text-xs text-[#9a9da6]">Nuxt 4</span>
            </div>
            <p class="grow text-[15px] text-[#b4b6bd]">La web del combat de glosa i corrandes: programa, reserves del dinar, inscripció de glosadors i un panell per canviar-ho tot.</p>
            <span class={goClass}>Obrir Combat de Glosa →</span>
          </div>
        </a>

      </div>
    </section>

    <section id="experiencia" class="rounded-t-[32px] bg-paper text-[#16171a]">
      <div class="mx-auto flex max-w-[1200px] flex-col gap-7 px-6 pt-20 pb-8">
        <div class="flex flex-wrap items-end justify-between gap-x-12 gap-y-3">
          <h2 class="font-display text-[clamp(32px,4vw,52px)] leading-[1.05] font-bold tracking-[-0.02em]">Experiència</h2>
          <p class="max-w-[460px] text-[#4b4d55]">Cinc etapes, del primer ecommerce al rol d'analista i programador fullstack.</p>
        </div>
        <div class="flex flex-col border-t-2 border-[#16171a]">
          {experience.map(({ role, period, company, location, tasks }) => (
            <article class="flex flex-wrap gap-x-8 gap-y-1.5 border-b border-[#d3d1c9] py-[22px]">
              <div class="flex-[0_0_200px] pt-1 font-mono text-[13px] text-[#4b4d55]">{period}</div>
              <div class="flex min-w-0 flex-[999_1_420px] flex-col gap-1">
                <h3 class="font-display text-xl font-semibold">{role}</h3>
                <div class="text-sm font-medium text-[#4b4d55]">{company} · {location}</div>
                <ul class="mt-1.5 flex max-w-[760px] flex-col gap-1 text-[15px]">
                  {tasks.map((task) => (
                    <li class="flex gap-2.5"><span aria-hidden="true" class="shrink-0 text-[#8a8c93]">—</span><span>{task}</span></li>
                  ))}
                </ul>
              </div>
            </article>
          ))}
        </div>
      </div>

      <div id="habilitats" class="mx-auto flex max-w-[1200px] flex-wrap gap-x-16 gap-y-10 px-6 pt-10 pb-[88px]">
        <div class="flex min-w-0 flex-[2_1_380px] flex-col gap-4">
          <h2 class="font-display text-[32px] font-bold tracking-[-0.02em]">Habilitats</h2>
          <ul class="flex flex-wrap gap-2 font-mono text-sm">
            {skills.map((s) => <li class="rounded-full border border-[#16171a] px-4 py-[9px]">{s}</li>)}
            <li class="rounded-full border border-[#16171a] bg-[#16171a] px-4 py-[9px] text-acid">Swift</li>
          </ul>
        </div>
        <div class="flex flex-[1_1_260px] flex-col gap-3">
          <h3 class="font-display text-xl font-semibold">Formació</h3>
          {education.map(({ period, title, center }) => (
            <div class="text-[15px]">{title}, {center}<br /><span class="font-mono text-xs text-[#4b4d55]">{period}</span></div>
          ))}
        </div>
        <div class="flex flex-[1_1_220px] flex-col gap-3">
          <h3 class="font-display text-xl font-semibold">Idiomes</h3>
          {languages.map(({ lang, level }) => <div class="text-[15px]">{lang}, {level}</div>)}
        </div>
      </div>
    </section>
  </main>

  <ContactFooter>
    Tens un projecte web a la Garrotxa o on sigui? Escriu-me i en parlem.
    <a href="/serveis" class="font-semibold underline">Mira què puc fer per la teva empresa.</a>
  </ContactFooter>

  <script>
    const pad = (n: number) => String(n).padStart(2, '0');
    const tick = () => {
      const d = new Date();
      document.querySelectorAll('[data-clock]').forEach((el) => (el.textContent = `${pad(d.getHours())}:${pad(d.getMinutes())}`));
    };
    tick();
    setInterval(tick, 15000);

    const glosaDays = document.querySelector('[data-glosa-days]');
    if (glosaDays) {
      const ms = new Date('2026-11-21T16:30:00+01:00').getTime() - Date.now();
      glosaDays.textContent = String(Math.max(0, Math.ceil(ms / 86_400_000)));
    }

    const keys: [string, string][] = [['S', 'Safari'], ['T', 'Terminal'], ['M', 'Mail'], ['N', 'Notes'], ['C', 'Calendari']];
    const letter = document.querySelector('[data-key-letter]');
    const app = document.querySelector('[data-key-app]');
    let i = 0;
    setInterval(() => {
      i = (i + 1) % keys.length;
      if (letter && app) [letter.textContent, app.textContent] = keys[i];
    }, 1600);
  </script>
</BaseLayout>
