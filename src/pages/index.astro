  <style>
    /* Hero relief: thin ink traces that draw in once, and light up in their accent when their link is hovered. */
    .relief .trace,
    .relief .pad {
      stroke: var(--color-ink);
      stroke-width: 1.5;
      transition: stroke 0.25s ease, stroke-width 0.25s ease;
    }
    .relief .pad { fill: var(--color-paper); }
    .relief .trace { stroke-dasharray: 1; stroke-dashoffset: 1; animation: draw 1.6s cubic-bezier(0.6, 0, 0.2, 1) forwards; }
    .relief .t2 { animation-delay: 0.15s; }
    .relief .t3 { animation-delay: 0.3s; }
    @keyframes draw { to { stroke-dashoffset: 0; } }
    .relief:has(.r1:hover, .r1:focus-visible) .t1 { stroke: var(--color-fageda-deep); stroke-width: 3; }
    .relief:has(.r2:hover, .r2:focus-visible) .t2 { stroke: var(--color-violeta-deep); stroke-width: 3; }
    .relief:has(.r3:hover, .r3:focus-visible) .t3 { stroke: var(--color-lava-deep); stroke-width: 3; }
    .relief:has(.r1:hover, .r1:focus-visible) rect.t1 { fill: var(--color-fageda); }
    .relief:has(.r2:hover, .r2:focus-visible) rect.t2 { fill: var(--color-violeta); }
    .relief:has(.r3:hover, .r3:focus-visible) rect.t3 { fill: var(--color-lava); }
    @media (prefers-reduced-motion: reduce) {
      .relief .trace { animation: none; stroke-dashoffset: 0; }
    }
  </style>

  <ContactFooter title="Parlem del teu projecte">
    Tens un projecte web a la Garrotxa o on sigui? Escriu-me i en parlem.
    <a href="/serveis">Mira què puc fer per la teva empresa.</a>
  </ContactFooter>

  <script>
    const glosaDays = document.querySelector('[data-glosa-days]');
    if (glosaDays) {
      const ms = new Date('2026-11-21T16:30:00+01:00').getTime() - Date.now();
      glosaDays.textContent = String(Math.max(0, Math.ceil(ms / 86_400_000)));
    }

  </script>
