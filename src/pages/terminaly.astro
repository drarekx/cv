---
import BaseLayout from '../layouts/BaseLayout.astro';
// Self-hosted fonts (no request to Google): only the families this page uses.
import '@fontsource-variable/jetbrains-mono';
import CopyCommand from '../components/CopyCommand.vue';
import ProjectFooter from '../components/ProjectFooter.astro';
import TerminalyDemo from '../components/terminaly/TerminalyDemo.vue';
import { project } from '../data/projects';

const p = project('terminaly');

const states = [
  { color: '#f2b84b', label: 'treballant', text: 'L\'agent està fent feina. No cal que miris.' },
  { color: '#6fdd8b', label: 'a punt', text: 'Ha acabat i espera la següent instrucció.' },
  { color: '#7ab7ff', label: 'et necessita', text: 'Demana una resposta: notificació i número a la icona del Dock.' },
];

const swarm = [
  ['Instal·la la skill', 'A Ajustos → Agents, la skill terminaly-swarm per a Claude Code o opencode.'],
  ['Demana un swarm', 'L\'agent que rep l\'encàrrec es converteix en el lead i reparteix la feina.'],
  ['Els workers treballen', 'Cadascun en una sessió i un worktree de git propis, penjats del lead a la barra lateral.'],
  ['El lead revisa i fusiona', 'Espera que acabin, revisa les branques i les fusiona. Els permisos sempre els aproves tu.'],
];

const features = [
  { title: 'Projectes i sessions', text: 'Barra lateral amb carpetes i les seves sessions: fixa, reanomena, arxiva, posa-hi color. Arrossega una carpeta per afegir-la.' },
  { title: 'Terminals de veritat', text: 'SwiftTerm a sota. Les sessions segueixen vives encara que no les tinguis a la vista.' },
  { title: 'Presets', text: 'Shell, Claude, Codex… editables a Ajustos. ⌘T llança el primer.' },
  { title: 'Panells dividits', text: '⌘D a la dreta, ⇧⌘D a sota, ⌘W tanca. La disposició es recorda.' },
  { title: 'Paleta d\'ordres', text: '⌘K per a tot. ⌘[ i ⌘] per passar d\'una sessió a l\'altra.' },
  { title: 'Tanca l\'app, no la feina', text: 'Les sessions viuen al dimoni tly. En tornar a obrir, es reconnecten amb la sortida recent.' },
  { title: 'Des del navegador', text: 'Obre les sessions del Mac des de qualsevol navegador de la xarxa local o la VPN, també des de l\'iPhone. Desactivat per defecte i protegit amb un token.' },
  { title: 'Pintat amb la GPU', text: 'Els terminals es dibuixen amb la GPU: la meitat de CPU mentre els agents treballen.' },
];

const cli: [string, string?][] = [
  ['tly ls'],
  ['tly new --command claude'],
  ['tly new --worktree tests --prompt "…"', '# un worker'],
  ['tly send <id> "text" --enter'],
  ['tly ask <id> "text"', '# envia i espera la resposta'],
  ['tly result <id>'],
  ['tly wait <id>… --any'],
  ['tly attach <id>', '# Ctrl-\\ per sortir'],
  ['tly kill --tree <id>'],
];

/** Structured data: a macOS app by the same person as the home page (#gerard). */
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: p.name,
  url: `https://www.gerardfortea.com/${p.slug}`,
  operatingSystem: 'macOS',
  applicationCategory: 'DeveloperApplication',
  softwareVersion: p.version?.replace(/^v/, ''),
  codeRepository: p.repo,
  inLanguage: 'ca',
  author: { '@id': 'https://www.gerardfortea.com/#gerard' },
};
---
<BaseLayout
  title="Terminaly — tots els teus agents, un sol terminal · Gerard Fortea"
  description="App nativa de macOS per dirigir sessions de Claude Code, Codex, opencode i shell per projecte. Un agent en pot dirigir d'altres en swarm, cadascun en el seu worktree."
  bodyClass="bg-[#050608] font-mono text-[15px] text-[#d6dbe2] antialiased"
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </Fragment>
  <header class="mx-auto flex max-w-[1240px] flex-wrap items-center justify-between gap-x-7 gap-y-1 px-6 py-4 text-[13px]">
    <a href="/" class="flex min-h-11 items-center hover:text-[#6fdd8b]">← gerard fortea</a>
    <div class="text-base font-extrabold text-white"><span class="text-[#6fdd8b]">&gt;_</span> terminaly</div>
    <a href="#installa" class="flex min-h-11 items-center text-[#6fdd8b] hover:text-white">instal·la'l</a>
  </header>

  <main id="main" tabindex="-1" class="outline-none">
    <section class="mx-auto flex max-w-[1240px] flex-col gap-5 px-6 pt-14 pb-10">
      <p class="text-[13px] text-[#6fdd8b]">$ open -a Terminaly</p>
      <h1 class="text-[clamp(34px,6vw,84px)] leading-[1.02] font-extrabold tracking-[-0.04em] text-white">
        Tots els teus agents.<br />Un sol terminal<span aria-hidden="true" class="animate-blink text-[#6fdd8b]">█</span>
      </h1>
      <p class="max-w-[680px] text-[17px] text-[#aab2bd]">
        App nativa de macOS per llançar i dirigir sessions d'agents de CLI. Claude, Codex, opencode i el teu shell, ordenats
        per projecte, i saps en tot moment qui treballa, qui ha acabat i qui t'espera. I ara un agent en pot dirigir d'altres:
        un swarm.
      </p>
    </section>

    <section class="mx-auto max-w-[1240px] px-6 pb-6">
      <TerminalyDemo client:load />
      <p class="mt-3.5 text-[13px] text-[#aab2bd]">El lead reparteix la feina entre tres workers, cadascun al seu worktree. Mira'ls tots alhora amb «mostra el swarm» i dona-li permís al que te'l demana.</p>
    </section>

    <section class="mx-auto flex max-w-[1240px] flex-wrap gap-x-14 gap-y-8 px-6 pt-[72px] pb-6">
      <div class="flex min-w-0 flex-[1_1_320px] flex-col gap-3.5">
        <h2 class="text-[clamp(26px,3.4vw,44px)] leading-[1.1] font-extrabold tracking-[-0.03em] text-white">Un agent que en dirigeix d'altres.</h2>
        <p class="text-sm text-[#aab2bd]">
          Amb el swarm, una tasca gran es reparteix entre diverses sessions que treballen alhora, sense trepitjar-se. Terminaly
          només posa les eines: sessions, worktrees i la CLI <span class="text-[#d6dbe2]">tly</span>. Fins a 6 workers per sessió
          (es canvia a Ajustos → Agents), i «Treu els workers acabats» neteja sessions i worktrees.
        </p>
      </div>
      <ol class="m-0 flex min-w-0 flex-[999_1_460px] flex-col">
        {swarm.map(([title, text], i) => (
          <li class="grid grid-cols-[36px_1fr] gap-x-3 border-t border-[#262c36] py-4">
            <span class="text-[#6fdd8b]">{i + 1}</span>
            <span class="flex flex-col gap-1"><strong class="font-bold text-white">{title}</strong><span class="text-sm text-[#aab2bd]">{text}</span></span>
          </li>
        ))}
      </ol>
    </section>

    <section class="mx-auto flex max-w-[1240px] flex-col gap-7 px-6 pt-[72px] pb-6">
      <h2 class="max-w-[820px] text-[clamp(26px,3.4vw,44px)] leading-[1.1] font-extrabold tracking-[-0.03em] text-white">Tres estats, d'un cop d'ull.</h2>
      <div class="grid grid-cols-[repeat(auto-fit,minmax(260px,1fr))] gap-4">
        {states.map((s) => (
          <div class="flex flex-col gap-1.5 rounded-xl border border-t-[3px] border-[#262c36] p-[22px]" style={{ borderTopColor: s.color }}>
            <div class="font-bold" style={{ color: s.color }}>● {s.label}</div>
            <p class="text-sm text-[#aab2bd]">{s.text}</p>
          </div>
        ))}
      </div>
      <p class="max-w-[820px] text-sm text-[#aab2bd]">
        Amb Claude Code i opencode, l'estat ve dels seus hooks i del seu plugin (s'instal·len des d'Ajustos → Agents). Amb la resta d'agents, de l'activitat de la sortida.
      </p>
    </section>

    <section class="mx-auto grid max-w-[1240px] grid-cols-[repeat(auto-fit,minmax(300px,1fr))] gap-x-12 gap-y-3 px-6 pt-14 pb-6">
      {features.map((f, i) => (
        <div class="border-t border-[#262c36] py-[18px]">
          <h3 class="mb-1.5 text-base font-bold text-white"><span class="text-[#6fdd8b]">{String(i + 1).padStart(2, '0')}</span> {f.title}</h3>
          <p class="text-sm text-[#aab2bd]">{f.text}</p>
        </div>
      ))}
    </section>

    <section class="mx-auto flex max-w-[1240px] flex-wrap gap-x-14 gap-y-8 px-6 pt-14 pb-6">
      <div class="flex min-w-0 flex-[1_1_320px] flex-col gap-3.5">
        <h2 class="text-[clamp(26px,3.4vw,44px)] leading-[1.1] font-extrabold tracking-[-0.03em] text-white">I també des de la línia d'ordres.</h2>
        <p class="text-sm text-[#aab2bd]">
          <span class="text-[#d6dbe2]">tly</span> és un sol procés per a totes les sessions i, alhora, la CLI per manar-les: llista, crea,
          envia text, espera respostes o enganxa-t'hi. És el que fa servir el lead d'un swarm per dirigir els seus workers.
        </p>
        <ul class="flex flex-col gap-2 text-sm text-[#aab2bd]">
          <li><span class="text-[#6fdd8b]">Terminaly</span> · app SwiftUI, pinta els terminals</li>
          <li><span class="text-[#6fdd8b]">tly</span> · dimoni i CLI, PTY sense polling</li>
          <li><span class="text-[#6fdd8b]">TerminalyKit</span> · protocol i sockets compartits</li>
        </ul>
      </div>
      <pre tabindex="0" aria-label="Ordres de la CLI tly" class="m-0 min-w-0 flex-[999_1_460px] overflow-x-auto rounded-[14px] border border-[#262c36] bg-[#0d1014] p-[22px] font-mono text-[13px] leading-[1.9]">{cli.map(([cmd, comment]) => (
        <div><span class="text-[#aab2bd]">$</span> {cmd}{comment && <span class="text-[#aab2bd]">{'    '}{comment}</span>}</div>
      ))}</pre>
    </section>

    <section id="installa" class="mx-auto max-w-[1240px] px-6 pt-[72px] pb-24">
      <div class="flex flex-col gap-5 rounded-2xl border-2 border-[#6fdd8b] p-[clamp(24px,4vw,52px)]">
        <h2 class="text-[clamp(26px,3.6vw,46px)] leading-[1.08] font-extrabold tracking-[-0.03em] text-white">Instal·la'l des d'on toca: el terminal.</h2>
        <CopyCommand
          client:visible
          command={p.install}
          prompt="$"
          copyLabel="copia"
          copiedLabel="copiat"
          codeClass="rounded-[10px] border border-[#262c36] bg-[#0d1014] text-[13px] text-[#d6dbe2]"
          buttonClass="rounded-[10px] border-0 bg-[#6fdd8b] font-bold text-[#04140a] hover:bg-white"
        />
        <p class="max-w-[780px] text-sm text-[#aab2bd]">
          Deixa Terminaly.app a Aplicacions i enllaça la CLI <span class="text-[#d6dbe2]">tly</span> (amb
          <span class="text-[#d6dbe2]">bash -s -- --no-cli</span> se la salta). Les versions noves arriben per l'actualitzador integrat.
        </p>
        <div class="flex flex-wrap gap-x-7 gap-y-2 text-[13px] font-bold">
          <span>macOS</span><span>Swift · SwiftUI · SwiftTerm</span><span>{p.version}</span>
          <a href={p.repo} class="text-[#6fdd8b] underline">github.com/drarekx/terminaly</a>
        </div>
      </div>
    </section>
  </main>

  <ProjectFooter current="terminaly" class="border-[#262c36] text-[#6fdd8b]" lowercase />
</BaseLayout>
