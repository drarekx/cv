---
import BaseLayout from '../layouts/BaseLayout.astro';
// Self-hosted fonts (no request to Google): only the families this page uses.
import '@fontsource-variable/jetbrains-mono';
import '@fontsource-variable/space-grotesk';
import SiteHeader from '../components/site/SiteHeader.astro';
import ContactFooter from '../components/site/ContactFooter.astro';
import BrandSymbol from '../components/site/BrandSymbol.astro';

const pageTitle = 'Programador web sènior a Olot i la Garrotxa · Consultor per a pimes';
const pageDescription = 'Programador web sènior a Olot i la Garrotxa. Assessorament tecnològic i aplicacions web a mida per a pimes, del primer consell a l\'aplicació en marxa.';

const services = [
  {
    title: "Desenvolupament web a mida",
    description: "Disseny i programació d'aplicacions web adaptades al vostre negoci: des de panells de gestió interna fins a plataformes orientades al client, amb tecnologies modernes i escalables.",
    icon: `<path stroke-linecap="round" stroke-linejoin="round" d="M17.25 6.75 22.5 12l-5.25 5.25m-10.5 0L1.5 12l5.25-5.25m7.5-3-4.5 16.5"/>`,
  },
  {
    title: "Assessorament tecnològic",
    description: "Anàlisi de les vostres necessitats digitals i orientació en la tria de les solucions més adequades: tecnologies, eines, arquitectura de sistemes i proveïdors de serveis cloud.",
    icon: `<path stroke-linecap="round" stroke-linejoin="round" d="M9.813 15.904 9 18.75l-.813-2.846a4.5 4.5 0 0 0-3.09-3.09L2.25 12l2.846-.813a4.5 4.5 0 0 0 3.09-3.09L9 5.25l.813 2.846a4.5 4.5 0 0 0 3.09 3.09L15.75 12l-2.846.813a4.5 4.5 0 0 0-3.09 3.09ZM18.259 8.715 18 9.75l-.259-1.035a3.375 3.375 0 0 0-2.455-2.456L14.25 6l1.036-.259a3.375 3.375 0 0 0 2.455-2.456L18 2.25l.259 1.035a3.375 3.375 0 0 0 2.456 2.456L21.75 6l-1.035.259a3.375 3.375 0 0 0-2.456 2.456Z"/>`,
  },
  {
    title: "Manteniment i evolució de projectes",
    description: "Suport tècnic continuat per a webs i aplicacions existents: correcció d'errors, implementació de noves funcionalitats i migració o modernització de tecnologies obsoletes.",
    icon: `<path stroke-linecap="round" stroke-linejoin="round" d="M11.42 15.17 17.25 21A2.652 2.652 0 0 0 21 17.25l-5.877-5.877M11.42 15.17l2.496-3.03c.317-.384.74-.626 1.208-.766M11.42 15.17l-4.655 5.653a2.548 2.548 0 1 1-3.586-3.586l5.653-4.655m5.8-2.079 1.323-1.612a4.5 4.5 0 0 0-6.364-6.364L8.198 6.168"/>`,
  },
  {
    title: "Digitalització de processos",
    description: "Identificació i automatització de fluxos de treball manuals mitjançant solucions digitals a mida, millorant l'eficiència operativa i reduint errors a la vostra pime.",
    icon: `<path stroke-linecap="round" stroke-linejoin="round" d="M3.75 3v11.25A2.25 2.25 0 0 0 6 16.5h2.25M3.75 3h-1.5m1.5 0h16.5m0 0h1.5m-1.5 0v11.25A2.25 2.25 0 0 1 18 16.5h-2.25m-7.5 0h7.5m-7.5 0-1 3m8.5-3 1 3m0 0 .5 1.5m-.5-1.5h-9.5m0 0-.5 1.5"/>`,
  },
];

const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Person",
      "@id": "https://www.gerardfortea.com/#gerard",
      "name": "Gerard Fortea Castellsague",
      "jobTitle": "Programador web sènior freelance i consultor tecnològic",
      "email": "fortea.gerard@mail.com",
      "telephone": "+34616271011",
      "address": {
        "@type": "PostalAddress",
        "addressLocality": "Maià de Montcal",
        "addressRegion": "la Garrotxa, Girona",
        "addressCountry": "ES"
      },
      "sameAs": [
        "https://www.linkedin.com/in/gerard-fortea-a3863741/",
        "https://github.com/drarekx"
      ]
    },
    {
      "@type": "ProfessionalService",
      "@id": "https://www.gerardfortea.com/serveis#servei",
      "url": "https://www.gerardfortea.com/serveis",
      "founder": { "@id": "https://www.gerardfortea.com/#gerard" },
      "name": "Gerard Fortea — Programador web sènior i consultor tecnològic a la Garrotxa",
      "description": pageDescription,
      "email": "fortea.gerard@mail.com",
      "telephone": "+34616271011",
      "address": {
        "@type": "PostalAddress",
        "addressLocality": "Maià de Montcal",
        "addressRegion": "la Garrotxa",
        "addressCountry": "ES"
      },
      "areaServed": [
        { "@type": "AdministrativeArea", "name": "la Garrotxa" },
        { "@type": "City", "name": "Olot" },
        { "@type": "AdministrativeArea", "name": "el Ripollès" },
        { "@type": "AdministrativeArea", "name": "la Selva" },
        { "@type": "AdministrativeArea", "name": "Girona" },
        { "@type": "AdministrativeArea", "name": "Catalunya" }
      ],
      "knowsAbout": [
        "Programació web",
        "Desenvolupament d'aplicacions web",
        "PHP", "JavaScript", "TypeScript", "Vue.js", "MySQL",
        "Assessorament tecnològic",
        "Digitalització de pimes"
      ],
      "hasOfferCatalog": {
        "@type": "OfferCatalog",
        "name": "Serveis de programació i consultoria web",
        "itemListElement": [
          { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Desenvolupament d'aplicacions web a mida" } },
          { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Assessorament tecnològic per a pimes" } },
          { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Manteniment i evolució de projectes web" } },
          { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Digitalització de processos empresarials" } }
        ]
      }
    }
  ]
};
const areas = ['Olot', 'la Garrotxa', 'el Ripollès', 'la Selva', 'Girona', 'Catalunya'];
const stack = ['PHP', 'JavaScript', 'TypeScript', 'Vue.js', 'MySQL'];
---
<BaseLayout
  title={pageTitle}
  description={pageDescription}
  bodyClass="bg-paper font-display text-ink antialiased"
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </Fragment>

  <SiteHeader current="serveis" />

  <main id="main" tabindex="-1" class="outline-none">
    <section class="relative overflow-hidden border-b border-line">
      <BrandSymbol class="pointer-events-none absolute -right-24 bottom-[-6%] h-auto w-[min(900px,90vw)] text-line max-md:hidden" stroke={0.8} />
      <div class="relative mx-auto flex max-w-[1200px] flex-wrap items-end gap-x-16 gap-y-12 px-6 pt-20 pb-24">
        <div class="flex min-w-0 flex-[1_1_600px] flex-col gap-7">
          <p class="text-xl tracking-[-0.01em] text-graphite">Programador web sènior freelance i consultor tecnològic</p>
          <h1 class="font-display text-[clamp(44px,6.8vw,96px)] leading-[0.94] font-medium tracking-[-0.04em]">
            Programador web a la Garrotxa, per a pimes
          </h1>
          <p class="max-w-[640px] text-lg leading-relaxed text-graphite">
            Soc <strong class="font-medium text-ink">Gerard Fortea</strong>,
            <strong class="font-medium text-ink">programador web sènior freelance a la Garrotxa</strong> (Maià de Montcal) amb més de
            15 anys d'experiència en programació i desenvolupament web. Ofereixo serveis
            d'<strong class="font-medium text-ink">assessorament tecnològic i desenvolupament d'aplicacions web a mida</strong>
            per a pimes de la Garrotxa, Olot i comarques veïnes.
          </p>
          <div class="flex flex-wrap gap-3">
            <a href="#contacte" class="flex min-h-[52px] items-center gap-3 bg-ink px-7 text-[15px] font-medium text-paper hover:bg-fageda hover:text-ink">Parlem del vostre projecte</a>
            <a href="#serveis" class="flex min-h-[52px] items-center border border-ink px-7 text-[15px] font-medium hover:bg-ink hover:text-paper">Veure els serveis</a>
          </div>
        </div>
        <dl class="m-0 flex-[0_1_330px] border-t border-ink text-[15px]">
          {[
            ['On', 'Maià de Montcal'],
            ['Zona', 'Olot i la Garrotxa'],
            ['Per a', 'Pimes i autònoms'],
            ['Experiència', 'Més de 15 anys'],
            ['Idiomes', 'Català, castellà, anglès'],
          ].map(([k, v]) => (
            <div class="grid grid-cols-[120px_1fr] border-b border-line py-2.5">
              <dt class="text-graphite">{k}</dt><dd>{v}</dd>
            </div>
          ))}
        </dl>
      </div>
    </section>

    <section id="serveis" aria-labelledby="serveis-titol" class="mx-auto flex max-w-[1200px] flex-col gap-10 px-6 pt-20 pb-20">
      <div class="flex flex-wrap items-end justify-between gap-x-12 gap-y-4">
        <h2 id="serveis-titol" class="font-display text-[clamp(34px,4.4vw,60px)] leading-[1] font-medium tracking-[-0.03em]">Què puc fer per la vostra empresa</h2>
        <p class="max-w-[440px] leading-relaxed text-graphite">Quatre maneres de treballar junts, del primer consell a l'aplicació en marxa.</p>
      </div>
      <div class="grid gap-px border border-ink bg-ink md:grid-cols-2">
        {services.map(({ title, description }) => (
          <article class="flex flex-col gap-5 bg-paper p-8 transition-colors hover:bg-white">
            <h3 class="font-display text-[26px] leading-tight font-medium tracking-[-0.02em]">{title}</h3>
            <p class="text-[15px] leading-relaxed text-graphite">{description}</p>
          </article>
        ))}
      </div>
      <p class="max-w-[760px] text-lg leading-relaxed text-graphite">
        Alguns exemples recents: la web del <a href="/casino-tortella" class="text-ink underline decoration-fageda underline-offset-4">Casino de Tortellà</a>,
        la del <a href="/combat-glosa" class="text-ink underline decoration-fageda underline-offset-4">Combat de Glosa</a> i la meva especialitat,
        les <a href="/#gestio" class="text-ink underline decoration-fageda underline-offset-4">aplicacions de gestió a mida</a>.
      </p>
    </section>

    <section class="border-t border-ink bg-white">
      <div class="mx-auto flex max-w-[1200px] flex-col gap-10 px-6 pt-20 pb-24">
        <div class="grid gap-x-16 gap-y-10 md:grid-cols-[2fr_1fr]">
          <div class="flex min-w-0 flex-col gap-5">
            <h2 class="font-display text-[clamp(34px,4.4vw,60px)] leading-[1] font-medium tracking-[-0.03em]">Un programador a prop</h2>
            <p class="max-w-[640px] text-[17px] leading-relaxed text-graphite">
              Tant si necessiteu un <strong class="font-medium text-ink">programador web a Olot</strong> o a qualsevol municipi de
              la Garrotxa, com si cerqueu un consultor tecnològic extern de confiança per a la vostra empresa, puc ajudar-vos a
              digitalitzar processos, crear o millorar la vostra presència digital i prendre les millors decisions tecnològiques.
            </p>
          </div>
          <div class="flex flex-col gap-4">
            <h3 class="text-[15px] text-graphite">On treballo</h3>
            <ul class="flex flex-wrap gap-2 text-[15px]">
              {areas.map((a) => <li class="border border-ink px-3 py-1.5">{a}</li>)}
            </ul>
            <h3 class="mt-4 text-[15px] text-graphite">Amb què treballo</h3>
            <ul class="flex flex-wrap gap-2 font-mono text-sm">
              {stack.map((s) => <li class="border border-ink px-3 py-1.5">{s}</li>)}
            </ul>
          </div>
        </div>
      </div>
    </section>
  </main>

  <ContactFooter title="Parlem del vostre projecte" voice="vos">
    Sense compromís. Expliqueu-me el que necessiteu i us faré una proposta.
  </ContactFooter>
</BaseLayout>
