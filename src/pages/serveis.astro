---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from '../components/site/SiteHeader.astro';
import ContactFooter from '../components/site/ContactFooter.astro';

const pageTitle = 'Programador web a la Garrotxa — Gerard Fortea, consultor tecnològic per a pimes';
const pageDescription = 'Programador web freelance a la Garrotxa (Olot, Maià de Montcal). Assessorament tecnològic i desenvolupament d\'aplicacions web a mida per a pimes. Més de 15 anys d\'experiència.';

const services = [
  {
    title: "Desenvolupament web a mida",
    description: "Disseny i programació d'aplicacions web adaptades al vostre negoci: des de panells de gestió interna fins a plataformes orientades al client, amb tecnologies modernes i escalables.",
    icon: `<path stroke-linecap="round" stroke-linejoin="round" d="M17.25 6.75 22.5 12l-5.25 5.25m-10.5 0L1.5 12l5.25-5.25m7.5-3-4.5 16.5"/>`,
  },
  {
    title: "Assessorament tecnològic",
    description: "Anàlisi de les vostres necessitats digitals i orientació en la tria de les solucions més adequades: tecnologies, eines, arquitectura de sistemes i proveïdors de serveis cloud.",
    icon: `<path stroke-linecap="round" stroke-linejoin="round" d="M9.813 15.904 9 18.75l-.813-2.846a4.5 4.5 0 0 0-3.09-3.09L2.25 12l2.846-.813a4.5 4.5 0 0 0 3.09-3.09L9 5.25l.813 2.846a4.5 4.5 0 0 0 3.09 3.09L15.75 12l-2.846.813a4.5 4.5 0 0 0-3.09 3.09ZM18.259 8.715 18 9.75l-.259-1.035a3.375 3.375 0 0 0-2.455-2.456L14.25 6l1.036-.259a3.375 3.375 0 0 0 2.455-2.456L18 2.25l.259 1.035a3.375 3.375 0 0 0 2.456 2.456L21.75 6l-1.035.259a3.375 3.375 0 0 0-2.456 2.456Z"/>`,
  },
  {
    title: "Manteniment i evolució de projectes",
    description: "Suport tècnic continuat per a webs i aplicacions existents: correcció d'errors, implementació de noves funcionalitats i migració o modernització de tecnologies obsoletes.",
    icon: `<path stroke-linecap="round" stroke-linejoin="round" d="M11.42 15.17 17.25 21A2.652 2.652 0 0 0 21 17.25l-5.877-5.877M11.42 15.17l2.496-3.03c.317-.384.74-.626 1.208-.766M11.42 15.17l-4.655 5.653a2.548 2.548 0 1 1-3.586-3.586l5.653-4.655m5.8-2.079 1.323-1.612a4.5 4.5 0 0 0-6.364-6.364L8.198 6.168"/>`,
  },
  {
    title: "Digitalització de processos",
    description: "Identificació i automatització de fluxos de treball manuals mitjançant solucions digitals a mida, millorant l'eficiència operativa i reduint errors a la vostra pime.",
    icon: `<path stroke-linecap="round" stroke-linejoin="round" d="M3.75 3v11.25A2.25 2.25 0 0 0 6 16.5h2.25M3.75 3h-1.5m1.5 0h16.5m0 0h1.5m-1.5 0v11.25A2.25 2.25 0 0 1 18 16.5h-2.25m-7.5 0h7.5m-7.5 0-1 3m8.5-3 1 3m0 0 .5 1.5m-.5-1.5h-9.5m0 0-.5 1.5"/>`,
  },
];

const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Person",
      "name": "Gerard Fortea Castellsague",
      "jobTitle": "Programador web freelance · Consultor tecnològic",
      "email": "fortea.gerard@mail.com",
      "telephone": "+34616271011",
      "address": {
        "@type": "PostalAddress",
        "addressLocality": "Maià de Montcal",
        "addressRegion": "la Garrotxa, Girona",
        "addressCountry": "ES"
      },
      "sameAs": [
        "https://www.linkedin.com/in/gerard-fortea-a3863741/",
        "https://github.com/drarekx"
      ]
    },
    {
      "@type": "ProfessionalService",
      "name": "Gerard Fortea — Programador web i consultor tecnològic a la Garrotxa",
      "description": pageDescription,
      "email": "fortea.gerard@mail.com",
      "telephone": "+34616271011",
      "address": {
        "@type": "PostalAddress",
        "addressLocality": "Maià de Montcal",
        "addressRegion": "la Garrotxa",
        "addressCountry": "ES"
      },
      "areaServed": [
        { "@type": "AdministrativeArea", "name": "la Garrotxa" },
        { "@type": "City", "name": "Olot" },
        { "@type": "AdministrativeArea", "name": "el Ripollès" },
        { "@type": "AdministrativeArea", "name": "la Selva" },
        { "@type": "AdministrativeArea", "name": "Girona" },
        { "@type": "AdministrativeArea", "name": "Catalunya" }
      ],
      "knowsAbout": [
        "Programació web",
        "Desenvolupament d'aplicacions web",
        "PHP", "JavaScript", "TypeScript", "Vue.js", "MySQL",
        "Assessorament tecnològic",
        "Digitalització de pimes"
      ],
      "hasOfferCatalog": {
        "@type": "OfferCatalog",
        "name": "Serveis de programació i consultoria web",
        "itemListElement": [
          { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Desenvolupament d'aplicacions web a mida" } },
          { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Assessorament tecnològic per a pimes" } },
          { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Manteniment i evolució de projectes web" } },
          { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Digitalització de processos empresarials" } }
        ]
      }
    }
  ]
};
const areas = ['Olot', 'la Garrotxa', 'el Ripollès', 'la Selva', 'Girona', 'Catalunya'];
const stack = ['PHP', 'JavaScript', 'TypeScript', 'Vue.js', 'MySQL'];
---
<BaseLayout
  title={pageTitle}
  description={pageDescription}
  fonts="Inter:wght@400;500;600&family=JetBrains+Mono:wght@400;700&family=Space+Grotesk:wght@500;600;700"
  bodyClass="bg-ink font-sans text-paper antialiased"
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </Fragment>

  <SiteHeader current="serveis" />

  <main>
    <section class="mx-auto flex max-w-[1200px] flex-wrap items-end gap-x-16 gap-y-10 px-6 pt-[72px] pb-[72px]">
      <div class="flex min-w-0 flex-[1_1_560px] flex-col gap-[22px]">
        <p class="font-mono text-[13px] text-acid">Programador web freelance · Consultor tecnològic per a pimes</p>
        <h1 class="font-display text-[clamp(40px,6.4vw,88px)] leading-none font-bold tracking-[-0.03em]">
          Programador web a la Garrotxa, <span class="text-acid">per a pimes.</span>
        </h1>
        <p class="max-w-[640px] text-lg text-[#b4b6bd]">
          Soc <strong class="font-semibold text-paper">Gerard Fortea</strong>,
          <strong class="font-semibold text-paper">programador web freelance a la Garrotxa</strong> (Maià de Montcal) amb més de
          15 anys d'experiència en programació i desenvolupament web. Ofereixo serveis
          d'<strong class="font-semibold text-paper">assessorament tecnològic i desenvolupament d'aplicacions web a mida</strong>
          per a pimes de la Garrotxa, Olot i comarques veïnes.
        </p>
        <div class="mt-2 flex flex-wrap gap-3">
          <a href="#contacte" class="flex min-h-[52px] items-center rounded-full bg-acid px-[26px] text-[15px] font-semibold text-ink hover:bg-white">Parlem del vostre projecte</a>
          <a href="#serveis" class="flex min-h-[52px] items-center rounded-full border border-[#4a4e59] px-[26px] text-[15px] font-semibold hover:border-paper">Veure els serveis</a>
        </div>
      </div>
      <dl class="m-0 grid flex-[0_1_340px] grid-cols-[auto_1fr] gap-x-[18px] gap-y-2 rounded-[20px] border border-[#2a2d35] bg-[#17191e] p-[22px] font-mono text-[13px]">
        <dt class="text-[#9a9da6]">on</dt><dd>Maià de Montcal</dd>
        <dt class="text-[#9a9da6]">zona</dt><dd>Olot i la Garrotxa</dd>
        <dt class="text-[#9a9da6]">per a</dt><dd>pimes i autònoms</dd>
        <dt class="text-[#9a9da6]">anys</dt><dd>+15 programant web</dd>
        <dt class="text-[#9a9da6]">idiomes</dt><dd>ca · es · en</dd>
      </dl>
    </section>

    <section id="serveis" aria-labelledby="serveis-titol" class="mx-auto flex max-w-[1200px] flex-col gap-8 px-6 pt-6 pb-[88px]">
      <div class="flex flex-wrap items-end justify-between gap-x-12 gap-y-3">
        <h2 id="serveis-titol" class="font-display text-[clamp(32px,4vw,52px)] leading-[1.05] font-bold tracking-[-0.02em]">Què puc fer per la vostra empresa</h2>
        <p class="max-w-[460px] text-[#b4b6bd]">Quatre maneres de treballar junts, del primer consell a l'aplicació en marxa.</p>
      </div>
      <div class="grid gap-6 md:grid-cols-2">
        {services.map(({ title, description, icon }, i) => (
          <article class="group flex flex-col gap-4 rounded-3xl border border-[#2a2d35] bg-[#17191e] p-7 transition duration-300 hover:-translate-y-1.5 hover:border-acid">
            <div class="flex items-center justify-between">
              <span class="flex h-12 w-12 items-center justify-center rounded-full bg-[#24272e] text-acid transition-colors group-hover:bg-acid group-hover:text-ink">
                <svg aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="h-6 w-6" set:html={icon} />
              </span>
              <span class="font-mono text-xs text-[#9a9da6]">{String(i + 1).padStart(2, '0')}</span>
            </div>
            <h3 class="font-display text-[24px] leading-tight font-bold">{title}</h3>
            <p class="text-[15px] text-[#b4b6bd]">{description}</p>
          </article>
        ))}
      </div>
    </section>

    <section class="rounded-t-[32px] bg-paper text-[#16171a]">
      <div class="mx-auto flex max-w-[1200px] flex-wrap gap-x-16 gap-y-10 px-6 pt-20 pb-[88px]">
        <div class="flex min-w-0 flex-[2_1_440px] flex-col gap-4">
          <h2 class="font-display text-[clamp(32px,4vw,52px)] leading-[1.05] font-bold tracking-[-0.02em]">Un programador a prop</h2>
          <p class="max-w-[640px] text-[17px] text-[#3c3e45]">
            Tant si necessiteu un <strong class="font-semibold text-[#16171a]">programador web a Olot</strong> o a qualsevol municipi de
            la Garrotxa, com si cerqueu un consultor tecnològic extern de confiança per a la vostra empresa, puc ajudar-vos a
            digitalitzar processos, crear o millorar la vostra presència digital i prendre les millors decisions tecnològiques.
          </p>
        </div>
        <div class="flex flex-[1_1_300px] flex-col gap-3">
          <h3 class="font-display text-xl font-semibold">On treballo</h3>
          <ul class="flex flex-wrap gap-2 font-mono text-sm">
            {areas.map((a) => <li class="rounded-full border border-[#16171a] px-4 py-[9px]">{a}</li>)}
          </ul>
          <h3 class="mt-4 font-display text-xl font-semibold">Amb què treballo</h3>
          <ul class="flex flex-wrap gap-2 font-mono text-sm">
            {stack.map((s) => <li class="rounded-full border border-[#16171a] px-4 py-[9px]">{s}</li>)}
          </ul>
        </div>
      </div>
    </section>
  </main>

  <ContactFooter title="Parlem del vostre projecte">
    Sense compromís. Expliqueu-me el que necessiteu i us faré una proposta.
  </ContactFooter>
</BaseLayout>
