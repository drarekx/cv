---
import '../styles/global.css';
import { alternates, defaultLang, ogLocale, type Lang } from '../i18n';
import { useUi } from '../i18n/ui';

interface Props {
  /** Language of this page: sets `<html lang>`, og:locale and the default texts. */
  lang: Lang;
  /**
   * Languages this page exists in, for hreflang and og:locale:alternate. Normally left out: it is worked out
   * from the route files (a page exists in es/en when src/pages/es|en/<slug>.astro does). With only one
   * language there are no alternates.
   */
  alternateLangs?: Lang[];
  title?: string;
  description?: string;
  /** Absolute or root-relative URL; defaults to this page's URL on the production domain. */
  canonical?: string;
  /** Root-relative path of the 1200×630 social preview image. */
  ogImage?: string;
  ogImageAlt?: string;
  bodyClass?: string;
  /** Keep the page out of search results (legal pages). */
  noindex?: boolean;
}
const t = useUi(Astro.props.lang).layout;
const {
  lang,
  alternateLangs,
  title = t.title,
  description = t.description,
  canonical,
  ogImage = '/og.png',
  ogImageAlt = t.ogImageAlt,
  bodyClass = 'bg-paper font-display text-ink antialiased',
  noindex = false,
} = Astro.props;

const site = Astro.site ?? new URL('https://www.gerardfortea.com');
// Internal links and the sitemap use paths without a trailing slash; the canonical matches them.
const path = (canonical ?? Astro.url.pathname).replace(/(.)\/$/, '$1');
const canonicalUrl = new URL(path, site).href;
const ogImageUrl = new URL(ogImage, site).href;
// The same page in the other languages (only those it exists in). x-default is the Catalan version.
const versions = alternates(Astro.url.pathname, alternateLangs);
const others = versions.length > 1 ? versions : [];
const xDefault = others.find((a) => a.lang === defaultLang);
---
<!DOCTYPE html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content="Gerard Fortea Castellsague" />
    <link rel="canonical" href={canonicalUrl} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    {others.map((a) => <link rel="alternate" hreflang={a.lang} href={a.href} />)}
    {xDefault && <link rel="alternate" hreflang="x-default" href={xDefault.href} />}
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap.xml" />
    <meta name="theme-color" content="#f7f7f4" />
    <meta name="color-scheme" content="light" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Gerard Fortea" />
    <meta property="og:locale" content={ogLocale[lang]} />
    {others.filter((a) => a.lang !== lang).map((a) => <meta property="og:locale:alternate" content={ogLocale[a.lang]} />)}
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogImageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    <!-- Speculation Rules: Chrome/Edge prefetch internal pages on hover and prerender them on click start; other browsers ignore it. -->
    <script is:inline type="speculationrules">
    {
      "prefetch": [{
        "where": { "and": [
          { "href_matches": "/*" },
          { "not": { "href_matches": "/api/*" } },
          { "not": { "href_matches": "/*.*" } },
          { "not": { "selector_matches": "[target=_blank], [download], .no-prefetch" } }
        ] },
        "eagerness": "moderate"
      }],
      "prerender": [{
        "where": { "and": [
          { "href_matches": "/*" },
          { "not": { "href_matches": "/api/*" } },
          { "not": { "href_matches": "/*.*" } },
          { "not": { "selector_matches": "[target=_blank], [download], .no-prefetch" } }
        ] },
        "eagerness": "conservative"
      }]
    }
    </script>

    <slot name="head" />
  </head>
  <body class={bodyClass}>
    <a href="#main" class="sr-only focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:z-[60] focus:bg-ink focus:px-5 focus:py-3 focus:font-medium focus:text-paper">{t.skipLink}</a>
    <slot />
  </body>
</html>
