---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  /** Absolute or root-relative URL; defaults to this page's URL on the production domain. */
  canonical?: string;
  /** Root-relative path of the 1200×630 social preview image. */
  ogImage?: string;
  ogImageAlt?: string;
  bodyClass?: string;
  /** Keep the page out of search results (legal pages). */
  noindex?: boolean;
}
const {
  title = 'Gerard Fortea — Programador sènior a la Garrotxa',
  description = 'Gerard Fortea, programador sènior a la Garrotxa (Olot) especialitzat en aplicacions de gestió a mida.',
  canonical,
  ogImage = '/og.png',
  ogImageAlt = 'Gerard Fortea, programador sènior a la Garrotxa: aplicacions de gestió a mida',
  bodyClass = 'bg-paper font-display text-ink antialiased',
  noindex = false,
} = Astro.props;

const site = Astro.site ?? new URL('https://www.gerardfortea.com');
// Internal links and the sitemap use paths without a trailing slash; the canonical matches them.
const path = (canonical ?? Astro.url.pathname).replace(/(.)\/$/, '$1');
const canonicalUrl = new URL(path, site).href;
const ogImageUrl = new URL(ogImage, site).href;
---
<!DOCTYPE html>
<html lang="ca">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content="Gerard Fortea Castellsague" />
    <link rel="canonical" href={canonicalUrl} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap.xml" />
    <meta name="theme-color" content="#f7f7f4" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Gerard Fortea" />
    <meta property="og:locale" content="ca_ES" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogImageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    <slot name="head" />
  </head>
  <body class={bodyClass}>
    <a href="#main" class="sr-only focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:z-[60] focus:bg-ink focus:px-5 focus:py-3 focus:font-medium focus:text-paper">Salta al contingut</a>
    <slot />
  </body>
</html>
