---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  /** Absolute or root-relative URL; defaults to this page's URL on the production domain. */
  canonical?: string;
  /** Root-relative path of the 1200×630 social preview image. */
  ogImage?: string;
  ogImageAlt?: string;
  /** Google Fonts css2 query (the part after `family=`), when the page needs more than Inter. */
  fonts?: string;
  bodyClass?: string;
}
const {
  title = 'Gerard Fortea — Programador a la Garrotxa',
  description = 'Gerard Fortea, programador a la Garrotxa (Olot) especialitzat en aplicacions de gestió a mida.',
  canonical,
  ogImage = '/og.png',
  ogImageAlt = 'Gerard Fortea, programador a la Garrotxa: aplicacions de gestió a mida',
  fonts = 'Inter:wght@300;400;500;600;700',
  bodyClass = 'bg-ink font-sans text-paper antialiased',
} = Astro.props;

const site = Astro.site ?? new URL('https://www.gerardfortea.com');
// Internal links and the sitemap use paths without a trailing slash; the canonical matches them.
const path = (canonical ?? Astro.url.pathname).replace(/(.)\/$/, '$1');
const canonicalUrl = new URL(path, site).href;
const ogImageUrl = new URL(ogImage, site).href;
---
<!DOCTYPE html>
<html lang="ca">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content="Gerard Fortea Castellsague" />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" href="/favicon.ico" />
    <link rel="sitemap" href="/sitemap.xml" />
    <meta name="theme-color" content="#0e0f12" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Gerard Fortea" />
    <meta property="og:locale" content="ca_ES" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogImageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href={`https://fonts.googleapis.com/css2?family=${fonts}&display=swap`} rel="stylesheet" />
    <slot name="head" />
  </head>
  <body class={bodyClass}>
    <slot />
  </body>
</html>
