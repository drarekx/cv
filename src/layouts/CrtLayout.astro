---
import { locales, localePath, ui, type Locale } from '../i18n/content';

interface Props {
  lang: Locale;
}
const { lang } = Astro.props;
const t = ui[lang];
const site = Astro.site;
const abs = (path: string) => (site ? new URL(path, site).href : undefined);
---
<!DOCTYPE html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={t.description} />
    <meta name="author" content="Gerard Fortea Castellsague" />
    <meta name="theme-color" content="#1C1B19" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={t.title} />
    <meta property="og:description" content={t.description} />
    <meta property="og:locale" content={t.ogLocale} />
    {site && <link rel="canonical" href={abs(localePath[lang])} />}
    {site && locales.map((l) => <link rel="alternate" hreflang={l} href={abs(localePath[l])} />)}
    {site && <link rel="alternate" hreflang="x-default" href={abs(localePath.ca)} />}
    <link rel="icon" href="/favicon.ico" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=VT323&family=IBM+Plex+Mono:wght@400;500;600&display=swap" rel="stylesheet" />
    <title>{t.title}</title>
  </head>
  <body>
    <slot />
  </body>
</html>

<style is:global>
  *,
  *::before,
  *::after {
    box-sizing: border-box;
  }
  html,
  body {
    margin: 0;
    height: 100%;
    overflow: hidden;
    background: #1c1b19;
  }
  body {
    font-family: 'IBM Plex Mono', ui-monospace, monospace;
    -webkit-font-smoothing: antialiased;
  }
</style>
