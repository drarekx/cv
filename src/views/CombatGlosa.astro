---
/** /combat-glosa. Texts: src/i18n/pages/combat-glosa.ts. Routes: src/pages/combat-glosa.astro, src/pages/es/…, src/pages/en/… */
import BaseLayout from '../layouts/BaseLayout.astro';
// Self-hosted fonts (no request to Google): only the families this page uses.
import '@fontsource-variable/inter';
import '@fontsource/caveat/700.css';
import ProjectFooter from '../components/ProjectFooter.astro';
import LangSwitch from '../components/site/LangSwitch.astro';
import GlosaHero from '../components/glosa/GlosaHero.vue';
import DinarDemo from '../components/glosa/DinarDemo.vue';
import { project } from '../data/projects';
import { localePath, type Lang } from '../i18n';
import { glosa } from '../i18n/pages/combat-glosa';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = glosa[lang];
const p = project('combat-glosa');

/** Structured data: a website made by the same person as the home page (#gerard). */
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'CreativeWork',
  name: t.meta.ldName,
  url: p.url,
  description: t.meta.ldDescription,
  inLanguage: lang,
  creator: { '@id': 'https://www.gerardfortea.com/#gerard' },
};
---
<BaseLayout
  lang={lang}
  title={t.meta.title}
  description={t.meta.description}
  bodyClass="bg-[#fdf6ec] font-sans text-[#111111] antialiased"
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </Fragment>
  <main id="main" tabindex="-1" class="outline-none">
    <GlosaHero client:load t={t.hero} homeHref={localePath(lang, '/')}>
      <LangSwitch slot="langswitch" lang={lang} />
    </GlosaHero>

    <section class="mx-auto flex max-w-[1100px] flex-wrap gap-x-14 gap-y-12 px-6 pt-20 pb-16">
      <div class="flex min-w-0 flex-[1_1_440px] flex-col gap-6">
        <h2 class="font-hand text-[clamp(44px,6vw,72px)] leading-[0.95] font-bold text-[#e5006d]">{t.about.title}</h2>
        <p class="text-lg">
          {t.about.text}
        </p>
        <ol class="flex flex-col bg-[#111111] text-white">
          {t.about.program.map((x) => (
            <li class="flex gap-5 border-b border-white/20 px-5 py-4 last:border-b-0">
              <span class="w-16 shrink-0 text-lg font-bold text-[#8fd94a]">{x.hora}</span>
              <span><strong class="block text-lg">{x.titol}</strong><span class="text-[#d9d4cb]">{x.text}</span></span>
            </li>
          ))}
        </ol>
      </div>
      <div class="flex-[1_1_340px]">
        <DinarDemo client:visible t={t.dinar} />
      </div>
    </section>

    <section class="bg-[#e9e5dd]">
      <div class="mx-auto flex max-w-[1100px] flex-col gap-6 px-6 py-20">
        <h2 class="font-hand text-[clamp(44px,6vw,72px)] leading-[0.95] font-bold text-[#8b1a1a]">{t.forms.title}</h2>
        <p class="max-w-[720px] text-lg">
          {t.forms.text}
        </p>
        <div tabindex="0" role="region" aria-label={t.forms.tableLabel} class="overflow-x-auto">
          <table class="w-full min-w-[640px] border-collapse border-[3px] border-[#111111] bg-[#fdf6ec] text-left">
            <thead class="bg-[#111111] text-white">
              <tr>{t.forms.head.map((h) => <th class="p-3">{h}</th>)}</tr>
            </thead>
            <tbody>
              {t.forms.rows.map((f) => (
                <tr class="border-t-2 border-[#111111]">
                  <th scope="row" class="p-3">{f.name}</th><td class="p-3">{f.where}</td><td class="p-3">{f.asks}</td><td class="p-3 font-bold">{f.mail}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>
    </section>

    <section class="mx-auto flex max-w-[1100px] flex-col gap-8 px-6 pt-20 pb-16">
      <h2 class="font-hand text-[clamp(44px,6vw,72px)] leading-[0.95] font-bold text-[#e5006d]">{t.how.title}</h2>
      <div class="grid gap-5 md:grid-cols-2 lg:grid-cols-3">
        {t.how.details.map((d) => (
          <article class="flex flex-col gap-2 border-[3px] border-[#111111] bg-white p-5">
            <h3 class="text-lg font-bold">{d.title}</h3>
            <p class="text-[15px]">{d.text}</p>
          </article>
        ))}
      </div>
    </section>

    <section class="mx-auto max-w-[1100px] px-6 pb-24">
      <div class="flex flex-wrap items-center justify-between gap-6 border-[3px] border-[#111111] bg-[#f4a3b9] p-[clamp(28px,4vw,52px)] shadow-[8px_8px_0_#111111]">
        <h2 class="font-hand text-[clamp(40px,5vw,64px)] leading-[0.95] font-bold">{t.cta.title}</h2>
        <a href={p.url} class="flex min-h-[52px] items-center bg-[#111111] px-6 font-bold text-white hover:bg-[#e5006d]">{t.cta.link}</a>
      </div>
    </section>
  </main>

  <ProjectFooter lang={lang} current="combat-glosa" class="border-[#111111] text-[#8b1a1a]" />
</BaseLayout>
