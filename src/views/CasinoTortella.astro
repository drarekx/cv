---
/** /casino-tortella. Texts: src/i18n/pages/casino-tortella.ts. Routes: src/pages/casino-tortella.astro, src/pages/es/…, src/pages/en/… */
import BaseLayout from '../layouts/BaseLayout.astro';
// Self-hosted fonts (no request to Google): only the families this page uses.
import '@fontsource/roboto/400.css';
import '@fontsource/roboto/500.css';
import '@fontsource/roboto/700.css';
import '@fontsource/roboto-slab/400.css';
import '@fontsource/roboto-slab/500.css';
import ProjectFooter from '../components/ProjectFooter.astro';
import LangSwitch from '../components/site/LangSwitch.astro';
import CasinoAgenda from '../components/casino/CasinoAgenda.vue';
import { project } from '../data/projects';
import { localePath, type Lang } from '../i18n';
import { casino } from '../i18n/pages/casino-tortella';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = casino[lang];
const p = project('casino-tortella');

const stack = ['October CMS 4.4', 'Laravel 12', 'PHP 8.5', 'MariaDB', 'Tailwind 4', 'Alpine 3'];

/** Structured data: a website made by the same person as the home page (#gerard). */
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'CreativeWork',
  name: t.meta.ldName,
  url: p.url,
  description: t.meta.ldDescription,
  inLanguage: lang,
  creator: { '@id': 'https://www.gerardfortea.com/#gerard' },
};
---
<BaseLayout
  lang={lang}
  title={t.meta.title}
  description={t.meta.description}
  bodyClass="bg-white font-roboto text-[#1c1c1c] antialiased"
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </Fragment>
  <header class="bg-[#1c1c1c] text-white">
    <div class="mx-auto flex max-w-[1200px] flex-wrap items-center justify-between gap-x-7 gap-y-1 px-6 py-3 text-sm">
      <a href={localePath(lang, '/')} class="flex min-h-11 items-center hover:text-[#55d8d2]">{t.header.backHome}</a>
      <div class="flex items-center gap-2.5 font-slab text-lg">
        <svg aria-hidden="true" viewBox="0 0 24 22" class="h-5 w-5"><path d="M12 0 24 22H0Z" fill="#55d8d2"></path></svg>
        Casino de Tortellà
      </div>
      <div class="flex items-center gap-x-4">
        <a href={p.url} class="flex min-h-11 items-center underline-offset-4 hover:text-[#55d8d2] hover:underline">{t.header.visit}</a>
        <LangSwitch lang={lang} />
      </div>
    </div>
  </header>

  <main id="main" tabindex="-1" class="outline-none">
    <section class="bg-[#55d8d2]">
      <div class="mx-auto flex max-w-[1200px] flex-wrap items-end gap-x-14 gap-y-10 px-6 pt-16 pb-16">
        <div class="flex min-w-0 flex-[1_1_560px] flex-col gap-5">
          <p class="text-sm font-medium">{t.hero.kicker}</p>
          <h1 class="font-slab text-[clamp(38px,6vw,76px)] leading-[1.02] font-normal tracking-[-0.01em]">
            {t.hero.title}
          </h1>
          <p class="max-w-[620px] text-lg">
            {t.hero.intro}
          </p>
          <div class="mt-2 flex flex-wrap gap-3">
            <a href={p.url} class="flex min-h-[52px] items-center bg-[#1c1c1c] px-6 font-medium text-white hover:bg-[#2c3542]">{t.hero.ctaVisit}</a>
            <a href="#cartellera" class="flex min-h-[52px] items-center border-2 border-[#1c1c1c] px-6 font-medium hover:bg-[#1c1c1c] hover:text-white">{t.hero.ctaAgenda}</a>
          </div>
        </div>
        <a href="https://combatglosa.casinotortella.cat/" class="flex flex-[0_1_340px] flex-col gap-2 bg-[#1c1c1c] p-6 text-white no-underline hover:bg-[#2c3542]">
          <span class="text-xs font-medium tracking-wider text-[#55d8d2] uppercase">{t.hero.featured.label}</span>
          <span class="font-slab text-[56px] leading-none">{t.hero.featured.day} <span class="text-2xl">{t.hero.featured.month}</span></span>
          <span class="font-slab text-2xl leading-tight">{t.hero.featured.title}</span>
          <span class="text-sm text-[#c3c8cf]">{t.hero.featured.place}</span>
        </a>
      </div>
    </section>

    <section id="cartellera" class="mx-auto flex max-w-[1200px] flex-col gap-8 px-6 pt-20 pb-16">
      <div class="flex flex-wrap items-end justify-between gap-x-12 gap-y-3">
        <h2 class="font-slab text-[clamp(30px,4vw,48px)] leading-[1.05] font-normal">{t.agendaSection.title}</h2>
        <p class="max-w-[480px] text-[#3d4756]">{t.agendaSection.text}</p>
      </div>
      <CasinoAgenda client:visible t={t.agenda} />
    </section>

    <section class="bg-[#1c1c1c] text-white">
      <div class="mx-auto flex max-w-[1200px] flex-col gap-10 px-6 py-20">
        <div class="flex flex-col gap-3">
          <h2 class="font-slab text-[clamp(30px,4vw,48px)] leading-[1.05] font-normal">{t.rules.title}</h2>
          <p class="max-w-[640px] text-[#c3c8cf]">
            {t.rules.text}
          </p>
        </div>
        <div class="grid gap-px bg-white/40 md:grid-cols-2 lg:grid-cols-3">
          {t.rules.items.map((r, i) => (
            <article class="flex flex-col gap-2 bg-[#1c1c1c] p-6">
              <span class="font-slab text-sm text-[#55d8d2]">{String(i + 1).padStart(2, '0')}</span>
              <h3 class="font-slab text-xl">{r.title}</h3>
              <p class="text-[15px] text-[#c3c8cf]">{r.text}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="mx-auto flex max-w-[1200px] flex-wrap gap-x-16 gap-y-10 px-6 pt-20 pb-20">
      <div class="flex min-w-0 flex-[2_1_440px] flex-col gap-4">
        <h2 class="font-slab text-[clamp(30px,4vw,48px)] leading-[1.05] font-normal">{t.how.title}</h2>
        <p class="max-w-[640px] text-[17px] text-[#3d4756]">
          {t.how.p1Before} <code class="bg-[#eceef1] px-1.5 font-mono text-[15px]">Casino.Web</code>{t.how.p1After}
        </p>
        <p class="max-w-[640px] text-[17px] text-[#3d4756]">
          {t.how.p2}
        </p>
      </div>
      <div class="flex flex-[1_1_300px] flex-col gap-3">
        <h3 class="font-slab text-xl">{t.how.stackTitle}</h3>
        <ul class="flex flex-wrap gap-2 text-sm">
          {stack.map((s) => <li class="border border-[#8b94a1] px-3.5 py-2">{s}</li>)}
        </ul>
      </div>
    </section>

    <section class="mx-auto max-w-[1200px] px-6 pb-24">
      <div class="flex flex-wrap items-center justify-between gap-6 bg-[#55d8d2] p-[clamp(28px,4vw,52px)]">
        <h2 class="font-slab text-[clamp(28px,3.6vw,44px)] leading-[1.05] font-normal">{t.cta.title}</h2>
        <a href={p.url} class="flex min-h-[52px] items-center bg-[#1c1c1c] px-6 font-medium text-white hover:bg-[#2c3542]">casino.mrdrarek.es →</a>
      </div>
    </section>
  </main>

  <ProjectFooter lang={lang} current="casino-tortella" class="border-[#c3c8cf] text-[#157f7c]" />
</BaseLayout>
