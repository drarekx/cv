---
/** /terminaly: Mac app page. Texts: src/i18n/pages/terminaly.ts. Routes: src/pages/terminaly.astro, src/pages/es/terminaly.astro, src/pages/en/terminaly.astro. */
import BaseLayout from '../layouts/BaseLayout.astro';
// Self-hosted fonts (no request to Google): only the families this page uses.
import '@fontsource-variable/jetbrains-mono';
import CopyCommand from '../components/CopyCommand.vue';
import ProjectFooter from '../components/ProjectFooter.astro';
import LangSwitch from '../components/site/LangSwitch.astro';
import TerminalyDemo from '../components/terminaly/TerminalyDemo.vue';
import { project } from '../data/projects';
import { canonicalPath, localePath, site, type Lang } from '../i18n';
import { terminaly } from '../i18n/pages/terminaly';
import { useUi } from '../i18n/ui';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = terminaly[lang];
const ui = useUi(lang);

const p = project('terminaly');

const stateColors = ['#f2b84b', '#6fdd8b', '#7ab7ff'];
const states = t.states.items.map((s, i) => ({ ...s, color: stateColors[i] }));

/** Commands are not translated; only their comments are. */
const cli: [string, string?][] = [
  ['tly ls'],
  ['tly new --command claude'],
  ['tly new --worktree tests --prompt "…"', t.cli.comments.worker],
  ['tly send <id> "text" --enter'],
  ['tly ask <id> "text"', t.cli.comments.ask],
  ['tly result <id>'],
  ['tly wait <id>… --any'],
  ['tly attach <id>', t.cli.comments.attach],
  ['tly kill --tree <id>'],
];

/** Structured data: a macOS app by the same person as the home page (#gerard). */
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: p.name,
  url: `${site}${canonicalPath(localePath(lang, `/${p.slug}`))}`,
  description: t.meta.description,
  operatingSystem: 'macOS',
  applicationCategory: 'DeveloperApplication',
  softwareVersion: p.version?.replace(/^v/, ''),
  codeRepository: p.repo,
  inLanguage: lang,
  author: { '@id': 'https://www.gerardfortea.com/#gerard' },
};

const hl = (s: string) => `<span class="text-[#d6dbe2]">${s}</span>`;
const swarmText = t.swarm.text.replace('{tly}', () => hl('tly'));
const cliText = t.cli.text.replace('{tly}', () => hl('tly'));
const installText = t.install.text.replace('{tly}', () => hl('tly')).replace('{flag}', () => hl('bash -s -- --no-cli'));
---
<BaseLayout
  lang={lang}
  title={t.meta.title}
  description={t.meta.description}
  bodyClass="bg-[#050608] font-mono text-[15px] text-[#d6dbe2] antialiased"
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </Fragment>
  <header class="mx-auto flex max-w-[1240px] flex-wrap items-center justify-between gap-x-7 gap-y-1 px-6 py-4 text-[13px]">
    <a href={localePath(lang, '/')} class="flex min-h-11 items-center hover:text-[#6fdd8b]">{t.header.back}</a>
    <div class="text-base font-extrabold text-white"><span class="text-[#6fdd8b]">&gt;_</span> terminaly</div>
    <div class="flex items-center gap-x-5">
      <a href="#installa" class="flex min-h-11 items-center text-[#6fdd8b] hover:text-white">{t.header.install}</a>
      <LangSwitch lang={lang} />
    </div>
  </header>

  <main id="main" tabindex="-1" class="outline-none">
    <section class="mx-auto flex max-w-[1240px] flex-col gap-5 px-6 pt-14 pb-10">
      <p class="text-[13px] text-[#6fdd8b]">$ open -a Terminaly</p>
      <h1 class="text-[clamp(34px,6vw,84px)] leading-[1.02] font-extrabold tracking-[-0.04em] text-white">
        {t.hero.h1Line1}<br />{t.hero.h1Line2}<span aria-hidden="true" class="motion-safe:animate-blink text-[#6fdd8b]">█</span>
      </h1>
      <p class="max-w-[680px] text-[17px] text-[#aab2bd]">{t.hero.text}</p>
    </section>

    <section class="mx-auto max-w-[1240px] px-6 pb-6">
      <TerminalyDemo client:load text={t.demo} />
      <p class="mt-3.5 text-[13px] text-[#aab2bd]">{t.demoCaption}</p>
    </section>

    <section class="mx-auto flex max-w-[1240px] flex-wrap gap-x-14 gap-y-8 px-6 pt-[72px] pb-6">
      <div class="flex min-w-0 flex-[1_1_320px] flex-col gap-3.5">
        <h2 class="text-[clamp(26px,3.4vw,44px)] leading-[1.1] font-extrabold tracking-[-0.03em] text-white">{t.swarm.title}</h2>
        <p class="text-sm text-[#aab2bd]" set:html={swarmText} />
      </div>
      <ol class="m-0 flex min-w-0 flex-[999_1_460px] flex-col">
        {t.swarm.steps.map(([title, text], i) => (
          <li class="grid grid-cols-[36px_1fr] gap-x-3 border-t border-[#262c36] py-4">
            <span class="text-[#6fdd8b]">{i + 1}</span>
            <span class="flex flex-col gap-1"><strong class="font-bold text-white">{title}</strong><span class="text-sm text-[#aab2bd]">{text}</span></span>
          </li>
        ))}
      </ol>
    </section>

    <section class="mx-auto flex max-w-[1240px] flex-col gap-7 px-6 pt-[72px] pb-6">
      <h2 class="max-w-[820px] text-[clamp(26px,3.4vw,44px)] leading-[1.1] font-extrabold tracking-[-0.03em] text-white">{t.states.title}</h2>
      <div class="grid grid-cols-[repeat(auto-fit,minmax(260px,1fr))] gap-4">
        {states.map((s) => (
          <div class="flex flex-col gap-1.5 rounded-xl border border-t-[3px] border-[#262c36] p-[22px]" style={{ borderTopColor: s.color }}>
            <div class="font-bold" style={{ color: s.color }}>● {s.label}</div>
            <p class="text-sm text-[#aab2bd]">{s.text}</p>
          </div>
        ))}
      </div>
      <p class="max-w-[820px] text-sm text-[#aab2bd]">{t.states.note}</p>
    </section>

    <section class="mx-auto grid max-w-[1240px] grid-cols-[repeat(auto-fit,minmax(300px,1fr))] gap-x-12 gap-y-3 px-6 pt-14 pb-6">
      {t.features.map((f, i) => (
        <div class="border-t border-[#262c36] py-[18px]">
          <h3 class="mb-1.5 text-base font-bold text-white"><span class="text-[#6fdd8b]">{String(i + 1).padStart(2, '0')}</span> {f.title}</h3>
          <p class="text-sm text-[#aab2bd]">{f.text}</p>
        </div>
      ))}
    </section>

    <section class="mx-auto flex max-w-[1240px] flex-wrap gap-x-14 gap-y-8 px-6 pt-14 pb-6">
      <div class="flex min-w-0 flex-[1_1_320px] flex-col gap-3.5">
        <h2 class="text-[clamp(26px,3.4vw,44px)] leading-[1.1] font-extrabold tracking-[-0.03em] text-white">{t.cli.title}</h2>
        <p class="text-sm text-[#aab2bd]" set:html={cliText} />
        <ul class="flex flex-col gap-2 text-sm text-[#aab2bd]">
          {t.cli.parts.map(([name, what]) => (
            <li><span class="text-[#6fdd8b]">{name}</span> · {what}</li>
          ))}
        </ul>
      </div>
      <pre tabindex="0" aria-label={t.cli.label} class="m-0 min-w-0 flex-[999_1_460px] overflow-x-auto rounded-[14px] border border-[#262c36] bg-[#0d1014] p-[22px] font-mono text-[13px] leading-[1.9]">{cli.map(([cmd, comment]) => (
        <div><span class="text-[#aab2bd]">$</span> {cmd}{comment && <span class="text-[#aab2bd]">{'    '}{comment}</span>}</div>
      ))}</pre>
    </section>

    <section id="installa" class="mx-auto max-w-[1240px] px-6 pt-[72px] pb-24">
      <div class="flex flex-col gap-5 rounded-2xl border-2 border-[#6fdd8b] p-[clamp(24px,4vw,52px)]">
        <h2 class="text-[clamp(26px,3.6vw,46px)] leading-[1.08] font-extrabold tracking-[-0.03em] text-white">{t.install.title}</h2>
        <CopyCommand
          client:visible
          command={p.install}
          prompt="$"
          copyLabel={t.install.copy}
          copiedLabel={t.install.copied}
          srCopied={ui.copy.srCopied}
          codeClass="rounded-[10px] border border-[#262c36] bg-[#0d1014] text-[13px] text-[#d6dbe2]"
          buttonClass="rounded-[10px] border-0 bg-[#6fdd8b] font-bold text-[#04140a] hover:bg-white"
        />
        <p class="max-w-[780px] text-sm text-[#aab2bd]" set:html={installText} />
        <div class="flex flex-wrap gap-x-7 gap-y-2 text-[13px] font-bold">
          <span>macOS</span><span>Swift · SwiftUI · SwiftTerm</span><span>{p.version}</span>
          <a href={p.repo} class="text-[#6fdd8b] underline">github.com/drarekx/terminaly</a>
        </div>
      </div>
    </section>
  </main>

  <ProjectFooter lang={lang} current="terminaly" class="border-[#262c36] text-[#6fdd8b]" lowercase />
</BaseLayout>
